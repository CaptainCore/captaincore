                return [ 'type' => 'redirect', 'label' => substr( (string) ( $m['redirect_url'] ?? '' ), 0, 200 ), 'status' => (int) ( $m['redirect_status'] ?? 302 ) ];
            }
            $type = (string) ( $m['resource_type'] ?? '' );
            $out  = [ 'type' => $type, 'label' => '' ];
            $pid  = (int) ( $m['page_id'] ?? 0 ) ?: ( (int) ( $m['p'] ?? 0 ) ?: (int) ( $m['post_id'] ?? 0 ) );
