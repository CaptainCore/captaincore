#!/usr/bin/env bash

#
#   Fetches site data
#
#   Returns key:value pairs, one per line.
#   Values may contain JSON. Split on the first colon only.
#

if [ ! -f "wp-config.php" ]; then
    echo "WordPress not found"
    exit
fi

# Install CaptainCore helper if missing
helper_check=$( wp plugin list --status=must-use --skip-themes --skip-plugins --skip-packages | grep "captaincore-helper" )
if [[ "$helper_check" == "" ]]; then
    curl https://run.captaincore.io/deploy-helper | bash -s
fi

# Content directory relative to the WordPress root: "wp-content" on a stock
# install, "app" on Bedrock, "content/<id>" on a WP Freighter tenant. Every
# filesystem probe below must use this, never the literal wp-content, or a
# Bedrock site gets fingerprinted from the dead tree its migration left behind.
wp_content=$( wp eval 'echo str_replace( rtrim( ABSPATH, "/" ) . "/", "", WP_CONTENT_DIR );' --skip-themes --skip-plugins --skip-packages 2>/dev/null | tail -1 )
wp_content="${wp_content%/}"
if [[ -z "$wp_content" || "$wp_content" == /* || ! -d "$wp_content" ]]; then
    wp_content="wp-content"
fi

plugins=$( wp plugin list --format=json --skip-themes --skip-plugins --skip-packages --fields=name,title,status,version )
themes=$(wp theme list --format=json --skip-themes --skip-plugins --skip-packages --fields=name,title,status,version )
mu_plugins=$( wp plugin list --status=must-use --format=json --skip-themes --skip-plugins --skip-packages --fields=name,title,status,version 2>/dev/null )
[[ -z "$mu_plugins" || "$mu_plugins" == "[]" ]] && mu_plugins="[]"
core=$( wp core version --skip-themes --skip-plugins --skip-packages )
home_url=$( wp option get home --skip-themes --skip-plugins --skip-packages )
users=$( wp user list --format=json --skip-themes --skip-plugins --skip-packages )
core_verify_checksums_response=$( wp core verify-checksums --skip-themes --skip-plugins --skip-packages 2>&1 )

# Parse checksum output into categorized arrays
modified_files=""
extra_files=""
missing_files=""
modified_paths=()
extra_paths=()

while IFS= read -r line; do
    case "$line" in
        "Warning: File doesn't verify against checksum: "*)
            file=$( echo "$line" | sed "s/Warning: File doesn't verify against checksum: //" )
            modified_files="${modified_files:+$modified_files,}\"$file\""
            modified_paths+=("$file")
            ;;
        "Warning: File should not exist: "*)
            file=$( echo "$line" | sed "s/Warning: File should not exist: //" )
            extra_files="${extra_files:+$extra_files,}\"$file\""
            extra_paths+=("$file")
            ;;
        "Warning: File doesn't exist: "*)
            file=$( echo "$line" | sed "s/Warning: File doesn't exist: //" )
            missing_files="${missing_files:+$missing_files,}\"$file\""
            ;;
    esac
done <<< "$core_verify_checksums_response"

# Determine status: "pass", "warning" (missing files only), or "fail" (modified or extra files)
if [[ -n "$modified_files" ]] || [[ -n "$extra_files" ]]; then
    core_verify_checksums=0
    checksum_status="fail"
elif [[ -n "$missing_files" ]]; then
    core_verify_checksums=1
    checksum_status="warning"
else
    core_verify_checksums=1
    checksum_status="pass"
fi

# Build JSON with categorized details
core_verify_checksums_json="{\"status\":\"$checksum_status\",\"modified\":[$modified_files],\"extra\":[$extra_files],\"missing\":[$missing_files]}"

# Plugin checksum verification against wordpress.org published hashes.
# Only plugins hosted on wordpress.org have published checksums; premium
# plugins without a checksums.json produce "skipping" warnings which are
# NOT failures. Genuine tampering is reported as tab-delimited rows in the
# format: slug<TAB>file<TAB>message.
plugin_verify_checksums_response=$( wp plugin verify-checksums --all --skip-themes --skip-plugins --skip-packages 2>&1 )

plugin_modified_entries=""
plugin_skipped_count=0

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    # Skip the header row that WP-CLI emits when there are failures
    [[ "$line" == "plugin_name"$'\t'* ]] && continue

    case "$line" in
        "Warning: Couldn't fetch response from"*)
            # HTTP fetch for the checksums JSON failed; paired with the
            # "Could not retrieve" line below. Ignored here to avoid double-counting.
            ;;
        "Warning: Could not retrieve the checksums"*)
            plugin_skipped_count=$((plugin_skipped_count + 1))
            ;;
        "Warning: Plugin "*"doesn't provide a readme.txt"*)
            plugin_skipped_count=$((plugin_skipped_count + 1))
            ;;
        "Success:"*|"Error:"*)
            # Terminal status lines are informational only
            ;;
        *$'\t'*$'\t'*)
            # Tab-delimited failure row: slug<TAB>file<TAB>message
            slug="${line%%$'\t'*}"
            rest="${line#*$'\t'}"
            file="${rest%%$'\t'*}"
            message="${rest#*$'\t'}"
            slug_esc=$( json_escape "$slug" )
            file_esc=$( json_escape "$file" )
            message_esc=$( json_escape "$message" )
            entry="{\"slug\":\"${slug_esc}\",\"file\":\"${file_esc}\",\"message\":\"${message_esc}\"}"
            plugin_modified_entries="${plugin_modified_entries:+$plugin_modified_entries,}${entry}"
            ;;
    esac
done <<< "$plugin_verify_checksums_response"

if [[ -n "$plugin_modified_entries" ]]; then
    plugin_checksum_status="fail"
else
    plugin_checksum_status="pass"
fi

plugin_checksum_details_json="{\"status\":\"${plugin_checksum_status}\",\"modified\":[${plugin_modified_entries}],\"skipped_count\":${plugin_skipped_count}}"

db_name=$( wp eval "echo DB_NAME;" --skip-plugins --skip-themes --skip-packages )
db_username=$( wp eval "echo DB_USER;" --skip-plugins --skip-themes --skip-packages )
db_password=$( wp eval "echo DB_PASSWORD;" --skip-plugins --skip-themes --skip-packages )

if $( wp core is-installed --network --skip-themes --skip-plugins --skip-packages ); then
    subsite_count=$( wp site list --format=count --skip-themes --skip-plugins --skip-packages )
fi

php_version=$( php -v | head -n1 | cut -d ' ' -f 2 | cut -d '.' -f 1,2 )
if [ -f "/etc/php/$php_version/fpm/php.ini" ]; then
    php_memory=$( cat "/etc/php/$php_version/fpm/php.ini" | grep "memory_limit" )
fi
if [[ "$php_memory" == "" ]]; then
    php_ini=$( wp eval 'echo php_ini_loaded_file();' )
    php_memory=$( cat "$php_ini" | grep "memory_limit" )
fi

read -r -d '' php_code << heredoc
\$line = '$php_memory';
preg_match( '/memory_limit = (\d\w+)/', '$php_memory', \$matches );
echo \$matches[1];
heredoc

php_memory=$( php -r "$php_code" )

default_role=$( wp option get default_role --skip-themes --skip-plugins --skip-packages )
if $( wp core is-installed --network --skip-themes --skip-plugins --skip-packages 2>/dev/null ); then
    registration=$( wp site option get registration --skip-themes --skip-plugins --skip-packages 2>/dev/null )
else
    registration=$( wp option get users_can_register --skip-themes --skip-plugins --skip-packages 2>/dev/null )
fi

token=$( wp eval "echo md5( AUTH_KEY );" --skip-plugins --skip-themes )

# Output key:value pairs (trim whitespace from WP-CLI output)
trim() { printf '%s' "$1" | tr -d '\n\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

echo "plugins:$(trim "$plugins")"
echo "wp_content:$(trim "$wp_content")"
# Plugins that vanish from the list once plugin code runs are hiding themselves
# (all_plugins / pre_current_active_plugins filters). The inventory above is
# taken with --skip-plugins, so it still sees them; the diff is the detector.
hidden_plugins_json="[]"
filtered_plugin_names=$( wp plugin list --field=name --skip-themes --skip-packages 2>/dev/null )
if [ -n "$filtered_plugin_names" ]; then
  unfiltered_plugin_names=$( wp plugin list --field=name --skip-themes --skip-plugins --skip-packages 2>/dev/null )
  hidden_names=$( comm -23 <(echo "$unfiltered_plugin_names" | sort -u) <(echo "$filtered_plugin_names" | sort -u) )
  if [ -n "$hidden_names" ]; then
    hidden_plugins_json=$( echo "$hidden_names" | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))' 2>/dev/null || echo "$hidden_names" | awk 'BEGIN{printf "["} {printf "%s\"%s\"", (NR>1?",":""), $0} END{print "]"}' )
  fi
fi
echo "hidden_plugins:$(trim "$hidden_plugins_json")"
# Media files changed in the last two days, checked for stashed payloads: magic
# bytes vs extension, bytes after the JPEG/PNG/GIF end marker, PHP or script
# markers in the first/last 16 KB, active SVG content. A compact copy of
# lib/remote-scripts/detect-media-payloads (the canonical, fuller version);
# keep the two in step. Emits JSON rows: severity, type, path, detail, size.
media_payloads_json="[]"
media_dirs=""
for _d in "$wp_content/uploads" wp-content/uploads app/uploads; do [ -d "$_d" ] && [[ " $media_dirs " != *" $_d "* ]] && media_dirs="$media_dirs $_d"; done
if [ -n "$media_dirs" ] && command -v perl >/dev/null 2>&1; then
  media_payloads_json=$( find $media_dirs \( -name node_modules -o -name .git -o -name cache \) -prune -o -type f -size +0 -mtime -2 -print0 2>/dev/null | LC_ALL=C perl -0ne '
    use strict; use warnings;
    BEGIN { our @out; }
    our @out;
    chomp(my $f = $_); $f =~ s/\0$//;
    my $size = -s $f or next;
    my ($name) = $f =~ m{([^/]+)$}; my $ext = lc($name =~ /\.([^.]+)$/ ? $1 : "");
    open(my $fh, "<:raw", $f) or next;
    my ($head, $tail) = ("", "");
    read($fh, $head, 16384);
    if ($size > 16384) { seek($fh, -16384, 2); read($fh, $tail, 16384); } else { $tail = $head; }
    my $report = sub { my ($sev, $type, $detail) = @_; $detail =~ s/[^\x20-\x7e]/./g; $detail =~ s/"/\x27/g; push @out, sprintf("{\"severity\":\"%s\",\"type\":\"%s\",\"path\":\"%s\",\"detail\":\"%s\",\"size\":%d}", $sev, $type, $f =~ s/"/\x27/gr, $detail, $size); };
    my %magic = (jpg => qr/^\xff\xd8\xff/, jpeg => qr/^\xff\xd8\xff/, png => qr/^\x89PNG\r\n\x1a\n/, gif => qr/^GIF8[79]a/, webp => qr/^RIFF....WEBP/s, pdf => qr/^%PDF/, mp4 => qr/^....ftyp/s, mov => qr/^....(ftyp|moov|mdat|wide|free)/s, mp3 => qr/^(ID3|\xff[\xfb\xf3\xf2])/, zip => qr/^PK/, ico => qr/^\x00\x00\x01\x00/);
    if (my $re = $magic{$ext}) {
        if ($head !~ $re) {
            (my $asc = substr($head, 0, 48)) =~ s/[^\x20-\x7e]/./g;
            if ($head =~ /^\s*(<\?php|<\?=|<script)/) { $report->("CRITICAL", "FAKE_MEDIA", "starts with code, not a .$ext: $asc"); }
            next;
        }
    }
    my %trailer = (jpg => ["\xff\xd9", "JPEG EOI"], jpeg => ["\xff\xd9", "JPEG EOI"], png => ["IEND\xaeB`\x82", "PNG IEND"], gif => ["\x3b", "GIF trailer"]);
    if (my $t = $trailer{$ext}) {
        my ($marker, $label) = @$t; my $pos = rindex($tail, $marker);
        my $trail = $pos < 0 ? -1 : length($tail) - $pos - length($marker);
        if ($trail < 0 || $trail > 64) {
            my $detail = $trail < 0 ? "no $label within the last 16 KB" : "$trail bytes after $label";
            my $after = $trail < 0 ? $tail : substr($tail, $pos + length($marker));
            # Samsung phones append an SEF block (SEFH ... SEFT) after the image: capture app
            # info as base64 JSON, editor state, a UTC stamp. Not a payload.
            next if $after =~ /SEFT\z/ || $after =~ /Samsung_Capture_Info|Image_UTC_Data|PhotoEditor_Re_Edit_Data|Original_Path_Hash_Key/;
            if ($after =~ /(<\?php|eval\(|base64_decode|\$_(?:POST|GET|REQUEST|COOKIE))/ || $after =~ m{[A-Za-z0-9+/]{200,}={0,2}}) { $report->("CRITICAL", "APPENDED_PAYLOAD", $detail); }
            elsif ($trail < 0 || $trail <= 4096) { $report->("MEDIUM", "TRAILING_DATA", "$detail (no code or base64 in it: phone cameras append metadata after the image, edited photos carry a second image)"); }
            else { $report->("HIGH", "TRAILING_DATA", $detail); }
            next;
        }
    }
    if ($ext =~ /^(jpe?g|png|gif|webp|ico|bmp|tiff?|pdf|mp4|m4v|mov|m4a|mp3|wav|ogg|webm|avi)$/) {
        if (($head . "\n" . $tail) =~ /(<\?php|<script[ >]|eval\(|base64_decode\(|shell_exec\(|\$_(?:POST|GET|REQUEST|COOKIE)\[)/) { $report->("CRITICAL", "CODE_IN_MEDIA", "contains $1"); next; }
    }
    if ($ext eq "svg" && $size <= 2097152) {
        seek($fh, 0, 0); local $/; my $svg = <$fh>;
        if ($svg =~ /(<script|\son[a-z]+\s*=|javascript:|<foreignObject|<iframe|<embed)/i) { $report->("HIGH", "SVG_ACTIVE", "SVG contains $1"); }
    }
    close $fh;
    END { print "[" . join(",", @out) . "]\n"; }
  ' 2>/dev/null )
  [ -z "$media_payloads_json" ] && media_payloads_json="[]"
fi
echo "media_payloads:$(trim "$media_payloads_json")"
# Database scan: export the option, post and comment rows that carry script or
# code markers (LIKE prefilters, so most rows never leave MySQL), the cron
# array, administrators, active plugins with missing files, triggers, events,
# routines and unknown tables. sync-data judges the export on the core server
# with the malware rules. Same PHP as lib/remote-scripts/db-scan (the
# canonical, documented version); keep the two in step.
db_scan_json="[]"
read -r -d '' DB_SCAN_PHP << 'DBSCANEOF'
<?php
// db-scan: export candidate rows and fixed facts. Arguments via constants set by the wrapper.
$since     = defined('DBSCAN_SINCE') ? (int) DBSCAN_SINCE : 2;
$full      = defined('DBSCAN_FULL') && DBSCAN_FULL;
$max_row   = defined('DBSCAN_MAX_ROW') ? (int) DBSCAN_MAX_ROW : 16384;
$max_total = defined('DBSCAN_MAX_TOTAL') ? (int) DBSCAN_MAX_TOTAL : 2097152;
global $wpdb;
$out = ['since_days' => $since, 'full' => $full, 'options' => [], 'posts' => [], 'comments' => [], 'admins' => [],
        'plugins_missing' => [], 'triggers' => [], 'events' => [], 'routines' => [], 'unknown_tables' => [],
        'suspicious_options' => [], 'stats' => [], 'truncated' => false];
$total = 0;
$cut = function ($s) use ($max_row) {
    $s = (string) $s;
    if (strlen($s) <= $max_row) return $s;
    return substr($s, 0, $max_row - 4096) . "\n/* ...cut... */\n" . substr($s, -4096);
};
$room = function ($len) use (&$total, $max_total, &$out) {
    if ($total + $len > $max_total) { $out['truncated'] = true; return false; }
    $total += $len; return true;
};
// Markers that make a row worth reading. Each is a case-insensitive LIKE.
$markers = ['<script', '<iframe', 'eval(', 'base64_decode', 'atob(', 'fromCharCode', 'document.write', '<?php', 'unescape(',
            'javascript:', 'String.fromCharCode', 'window.location', 'display:none', 'visibility:hidden', '\\x2', '\\x3', '\\x6', '\\x7',
            'gzinflate', 'str_rot13', 'create_function', 'assert(', 'passthru', 'shell_exec'];
$like = function ($col) use ($markers, $wpdb) {
    $parts = [];
    foreach ($markers as $m) $parts[] = $wpdb->prepare("$col LIKE %s", '%' . $wpdb->esc_like($m) . '%');
    return '(' . implode(' OR ', $parts) . ')';
};

// Options: every row with a marker, cut to size. The cron array is always included.
$rows = $wpdb->get_results("SELECT option_name, autoload, LENGTH(option_value) AS len FROM {$wpdb->options} WHERE " . $like('option_value') . " OR option_name = 'cron' ORDER BY len DESC LIMIT 400");
foreach ($rows as $r) {
    $v = $wpdb->get_var($wpdb->prepare("SELECT option_value FROM {$wpdb->options} WHERE option_name = %s", $r->option_name));
    $v = $cut($v);
    if (!$room(strlen($v))) break;
    $out['options'][] = ['name' => $r->option_name, 'autoload' => $r->autoload, 'size' => (int) $r->len, 'content' => $v];
}
$out['stats']['options_total'] = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->options}");
$out['stats']['options_exported'] = count($out['options']);
// Option names seen in past injections.
$bad_names = ['%seoinj%', '%html_inject%', '%wp_class_editor%', '%backupdb%', '%wp_check_hash%', '%wpupdates_hash%', '%_transient_wp_cache_key%', '%wp_head_inject%', '%footer_inject%'];
foreach ($bad_names as $bn) {
    foreach ($wpdb->get_col($wpdb->prepare("SELECT option_name FROM {$wpdb->options} WHERE option_name LIKE %s LIMIT 20", $bn)) as $n) $out['suspicious_options'][] = $n;
}
$out['suspicious_options'] = array_values(array_unique($out['suspicious_options']));

// Posts and comments: rows with a marker, changed recently (or all, chunked, for --full).
$posts_checked = 0;
if ($full) {
    $max_id = (int) $wpdb->get_var("SELECT MAX(ID) FROM {$wpdb->posts}");
    for ($lo = 0; $lo <= $max_id; $lo += 5000) {
        $hi = $lo + 5000;
        $posts_checked += (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->posts} WHERE ID >= $lo AND ID < $hi");
        $rows = $wpdb->get_results("SELECT ID, post_type, post_status, post_modified_gmt, post_title, post_content FROM {$wpdb->posts} WHERE ID >= $lo AND ID < $hi AND post_type NOT IN ('revision') AND " . $like('post_content') . " LIMIT 200");
        foreach ($rows as $r) {
            $c = $cut($r->post_content);
            if (!$room(strlen($c))) break 2;
            $out['posts'][] = ['id' => (int) $r->ID, 'type' => $r->post_type, 'status' => $r->post_status, 'modified' => $r->post_modified_gmt, 'title' => substr($r->post_title, 0, 200), 'content' => $c];
        }
        usleep(200000);
    }
} else {
    $since_sql = $wpdb->prepare("post_modified_gmt >= DATE_SUB(UTC_TIMESTAMP(), INTERVAL %d DAY)", $since);
    $posts_checked = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->posts} WHERE $since_sql");
    $rows = $wpdb->get_results("SELECT ID, post_type, post_status, post_modified_gmt, post_title, post_content FROM {$wpdb->posts} WHERE $since_sql AND post_type NOT IN ('revision') AND " . $like('post_content') . " LIMIT 300");
    foreach ($rows as $r) {
        $c = $cut($r->post_content);
        if (!$room(strlen($c))) break;
        $out['posts'][] = ['id' => (int) $r->ID, 'type' => $r->post_type, 'status' => $r->post_status, 'modified' => $r->post_modified_gmt, 'title' => substr($r->post_title, 0, 200), 'content' => $c];
    }
}
$out['stats']['posts_checked'] = $posts_checked;
$out['stats']['posts_exported'] = count($out['posts']);
$csince = $full ? '1=1' : $wpdb->prepare("comment_date_gmt >= DATE_SUB(UTC_TIMESTAMP(), INTERVAL %d DAY)", $since);
$rows = $wpdb->get_results("SELECT comment_ID, comment_post_ID, comment_approved, comment_date_gmt, comment_author_url, comment_content FROM {$wpdb->comments} WHERE $csince AND " . $like('comment_content') . " LIMIT 200");
foreach ($rows as $r) {
    $c = $cut($r->comment_content);
    if (!$room(strlen($c))) break;
    $out['comments'][] = ['id' => (int) $r->comment_ID, 'post' => (int) $r->comment_post_ID, 'approved' => $r->comment_approved, 'date' => $r->comment_date_gmt, 'url' => $r->comment_author_url, 'content' => $c];
}
$out['stats']['comments_exported'] = count($out['comments']);

// Administrators, including super admins on multisite.
$admins = [];
foreach (get_users(['role' => 'administrator', 'fields' => ['ID', 'user_login', 'user_email', 'user_registered']]) as $u) {
    $admins[$u->ID] = ['id' => (int) $u->ID, 'login' => $u->user_login, 'email' => $u->user_email, 'registered' => $u->user_registered, 'super' => false];
}
if (is_multisite()) {
    foreach (get_super_admins() as $login) {
        $u = get_user_by('login', $login);
        if ($u) $admins[$u->ID] = ['id' => (int) $u->ID, 'login' => $u->user_login, 'email' => $u->user_email, 'registered' => $u->user_registered, 'super' => true];
    }
}
$out['admins'] = array_values($admins);

// Active plugins whose main file is gone: a loader that was deleted but left
// registered, or an entry pointing outside plugins/.
$active = (array) get_option('active_plugins', []);
if (is_multisite()) $active = array_merge($active, array_keys((array) get_site_option('active_sitewide_plugins', [])));
foreach ($active as $p) {
    if (!is_string($p)) continue;
    if (!file_exists(WP_PLUGIN_DIR . '/' . $p) || strpos($p, '..') !== false) $out['plugins_missing'][] = $p;
}

// Triggers, events and routines: WordPress never creates them.
$db = DB_NAME;
$out['triggers'] = $wpdb->get_col($wpdb->prepare("SELECT TRIGGER_NAME FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA = %s", $db)) ?: [];
$out['events']   = $wpdb->get_col($wpdb->prepare("SELECT EVENT_NAME FROM INFORMATION_SCHEMA.EVENTS WHERE EVENT_SCHEMA = %s", $db)) ?: [];
$out['routines'] = $wpdb->get_col($wpdb->prepare("SELECT ROUTINE_NAME FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_SCHEMA = %s", $db)) ?: [];

// Tables outside the core set and the common plugin prefixes.
$core = ['commentmeta', 'comments', 'links', 'options', 'postmeta', 'posts', 'termmeta', 'term_relationships', 'term_taxonomy', 'terms', 'usermeta', 'users',
         'blogmeta', 'blogs', 'blog_versions', 'registration_log', 'signups', 'site', 'sitemeta'];
$known = ['actionscheduler_', 'woocommerce_', 'wc_', 'gf_', 'rg_', 'yoast_', 'wpforms_', 'e_', 'elementor', 'aioseo_', 'rank_math', 'seopress', 'redirection_', 'cleantalk',
          'smush', 'ewwwio', 'mailchimp', 'mc4wp', 'wpcode', 'searchwp', 'simple_history', 'snippets', 'litespeed', 'wpml', 'icl_', 'pmxi_', 'pmxe_', 'frm_', 'nf3_', 'cf7', 'wpmailsmtp',
          'wsal_', 'defender', 'ac_', 'admin_columns', 'tec_', 'wp_rocket', 'wprocket', 'edd_', 'affiliate_wp', 'affiliatewp', 'learndash', 'ld_', 'mepr_', 'pms_', 'um_', 'bp_', 'wpsc_',
