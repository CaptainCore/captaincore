#!/usr/bin/env bash

#
#   Deploys Mailgun
#
#   `deploy-mailgun --key=<key> --domain=<domain> [--name=<name>]`
#
#   Without --name the site keeps its current from name: the Gravity SMTP generic
#   connector's, then the PHP mail connector's, then the site title.
#

# Loop through arguments and separate regular arguments from flags
for arg in "$@"; do

  # Add to arguments array. (Does not starts with "--")
  if [[ $arg != --* ]]; then
    count=1+${#arguments[*]}
    arguments[$count]=$arg
    continue
  fi

  # Remove leading "--"
  flag_name=$( echo $arg | cut -c 3- )

  # Add to flags array
  count=1+${#flags[*]}
  flags[$count]=$arg

  # Process flags without data (Assign to variable)
  if [[ $arg != *"="* ]]; then
    flag_name=${flag_name//-/_}
    [[ $flag_name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && declare "$flag_name"=true
  fi

  # Process flags with data (Assign to variable)
  if [[ $arg == *"="* ]]; then
    flag_value=$( echo $flag_name | perl -n -e '/.+?=(.+)/&& print $1' ) # extract value
    flag_name=$( echo $flag_name | perl -n -e '/(.+?)=.+/&& print $1' ) # extract name
    flag_name=${flag_name/-/_}

    # Remove first and last quote if found
    flag_value="${flag_value%\"}"
    flag_value="${flag_value#\"}"

    [[ $flag_name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && declare "$flag_name"="$flag_value"
    continue
  fi

done

if [[ -z "$name" ]]; then
  read -r -d '' from_name_php << 'PHPEOF'
<?php
foreach ( [ 'gravitysmtp_generic', 'gravitysmtp_phpmail' ] as $option ) {
	$raw    = get_option( $option );
	$config = is_string( $raw ) ? json_decode( $raw, true ) : $raw;
	if ( is_array( $config ) && trim( $config['from_name'] ?? '' ) !== '' ) {
		echo trim( $config['from_name'] );
		return;
	}
}
echo html_entity_decode( get_option( 'blogname' ), ENT_QUOTES );
PHPEOF
  name=$( echo "$from_name_php" | wp eval-file - --skip-plugins --skip-themes 2>/dev/null )
  echo "Keeping from name: $name"
fi

# JSON-escape the name; it is interpolated into the connector JSON below.
name=$( printf '%s' "$name" | php -r 'echo substr( json_encode( stream_get_contents( STDIN ), JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES ), 1, -1 );' )

wp plugin install $gravitysmtp_zip --force --activate --skip-plugins --skip-themes

read -r -d '' gravitysmtp_config << heredoc
{"debug_log_enabled":"false","setup_wizard_should_display":"false","license_key":"$key","enabled_connector":{"generic":"true","phpmail":"true"},"primary_connector":{"generic":"true","phpmail":"false"},"backup_connector":{"generic":"false","phpmail":"true"}}
heredoc

read -r -d '' gravitysmtp_generic << heredoc
{"host":"smtp.mailgun.org","port":"587","auth":true,"username":"postmaster@$domain","password":"$password","from_email":"no-reply@$domain","force_from_email":true,"from_name":"$name","force_from_name":true,"encryption_type":"tls","auto_tls":true,"activated":true,"configured":true,"enabled":true,"is_primary":true,"is_backup":false}
heredoc

root_domain=$(wp option get home --skip-plugins --skip-themes)
root_domain=${root_domain/http:\/\/www./}            # removes http://www.
root_domain=${root_domain/https:\/\/www./}           # removes https://www.
root_domain=${root_domain/http:\/\//}                # removes https://
root_domain=${root_domain/https:\/\//}               # removes http://
root_domain=$( echo $root_domain | awk '{$1=$1};1' ) # Trims whitespace

read -r -d '' gravitysmtp_phpmail << heredoc
{"enabled":true,"is_primary":false,"is_backup":true,"from_email":"wordpress@$root_domain","force_from_email":true,"from_name":"$name","force_from_name":true,"use_return_path":false,"activated":true,"configured":true}
heredoc

wp option set gravitysmtp_config "$gravitysmtp_config"
wp option set gravitysmtp_generic "$gravitysmtp_generic"
wp option set gravitysmtp_phpmail "$gravitysmtp_phpmail"