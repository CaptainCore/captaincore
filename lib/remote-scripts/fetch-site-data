#!/usr/bin/env bash

#
#   Fetches site data
#
#   Returns key:value pairs, one per line.
#   Values may contain JSON. Split on the first colon only.
#
#   Optimized layout:
#   - Consolidates all --skip-plugins WordPress probes into one wp eval-file boot (Worker 1)
#   - Runs core checksums + root provenance + loose PHP + media payloads concurrently (Worker 2)
#   - Runs plugin checksums concurrently (Worker 3)
#   - Runs parallelized component_hashes + mu_plugin_files + hidden_plugins boot concurrently (Worker 4)
#

if [ ! -f "wp-config.php" ]; then
    # WordPress in a subdirectory (wp-cli.yml "path: wp/") or with wp-config.php one level up.
    # Ask WP-CLI where core lives and work from there, so every relative probe below sees the
    # real install. Only follow it to the home directory or below.
    wp_root=$( wp eval 'echo ABSPATH;' --skip-themes --skip-plugins --skip-packages 2>/dev/null | tail -1 )
    wp_root="${wp_root%/}"
    if [[ -z "$wp_root" || ! -f "$wp_root/wp-load.php" ]] || [[ "$wp_root" != "$(pwd -P)" && "$wp_root" != "$(pwd -P)/"* ]] || ! cd "$wp_root"; then
        echo "WordPress not found"
        exit
    fi
fi

# Content directory relative to the WordPress root: "wp-content" on a stock
# install, "app" on Bedrock, "content/<id>" on a WP Freighter tenant. Fast path
# skips an extra wp boot on stock layouts where WP_CONTENT_DIR is not customized.
if [[ -d "wp-content" ]] && ! grep -q "WP_CONTENT_DIR" wp-config.php 2>/dev/null; then
    wp_content="wp-content"
else
    wp_content=$( wp eval 'echo str_replace( rtrim( ABSPATH, "/" ) . "/", "", WP_CONTENT_DIR );' --skip-themes --skip-plugins --skip-packages 2>/dev/null | tail -1 )
    wp_content="${wp_content%/}"
    if [[ -z "$wp_content" || "$wp_content" == /* || ! -d "$wp_content" ]]; then
        wp_content="wp-content"
    fi
fi

# Install CaptainCore helper if missing (fast file check avoids an extra wp boot on 99.9% of sites).
if [ ! -f "$wp_content/mu-plugins/captaincore-helper.php" ]; then
    helper_check=$( wp plugin list --status=must-use --skip-themes --skip-plugins --skip-packages 2>/dev/null | grep "captaincore-helper" )
    if [[ "$helper_check" == "" ]]; then
        curl -s https://run.captaincore.io/deploy-helper | bash -s >/dev/null 2>&1
    fi
fi

trim() { printf '%s' "$1" | tr -d '\n\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'; }

json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '%s' "$s"
}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

# ----------------------------------------------------------------------------
# Worker 1: Single consolidated --skip-plugins WordPress boot for all WP/DB probes
# ----------------------------------------------------------------------------
(
read -r -d '' CONSOLIDATED_PHP << 'CONSOLIDATEDEOF'
<?php
global $wpdb, $wp_version;

$emit = function ( $k, $v ) {
    echo $k . ':' . trim( str_replace( [ "\r", "\n" ], '', (string) $v ) ) . "\n";
};

$run_probe = function ( $key, $fn, $fallback = '[]' ) use ( $emit ) {
    ob_start();
    try {
        $fn();
        $out = trim( (string) ob_get_clean() );
    } catch ( \Throwable $e ) {
        ob_end_clean();
        $out = '';
    }
    $emit( $key, $out !== '' ? $out : $fallback );
};

$run_multi_probe = function ( $fn, $defaults ) use ( $emit ) {
    ob_start();
    try {
        $fn();
        $raw = (string) ob_get_clean();
    } catch ( \Throwable $e ) {
        ob_end_clean();
        $raw = '';
    }
    $found = [];
    foreach ( explode( "\n", $raw ) as $line ) {
        $pos = strpos( $line, ':' );
        if ( $pos === false ) { continue; }
        $k = substr( $line, 0, $pos );
        if ( array_key_exists( $k, $defaults ) ) {
            $found[ $k ] = substr( $line, $pos + 1 );
        }
    }
    foreach ( $defaults as $k => $def ) {
        $v = isset( $found[ $k ] ) && trim( $found[ $k ] ) !== '' ? $found[ $k ] : $def;
        $emit( $k, $v );
    }
};

// --- Core metadata, plugins, themes, mu-plugins, users, db_size, security_log ---
( function () use ( $wpdb, $wp_version, $emit ) {
    if ( ! function_exists( 'get_plugins' ) ) {
        require_once ABSPATH . 'wp-admin/includes/plugin.php';
    }
    $active     = (array) get_option( 'active_plugins', [] );
    $net_active = is_multisite() ? (array) get_site_option( 'active_sitewide_plugins', [] ) : [];

    $plugins          = [];
    $unfiltered_names = [];
    foreach ( get_plugins() as $file => $data ) {
        $slug   = strpos( $file, '/' ) !== false ? dirname( $file ) : basename( $file, '.php' );
        $status = isset( $net_active[ $file ] ) ? 'active-network' : ( in_array( $file, $active, true ) ? 'active' : 'inactive' );
        $plugins[] = [
            'name'    => $slug,
            'title'   => (string) ( $data['Name'] ?? '' ),
            'status'  => $status,
            'version' => (string) ( $data['Version'] ?? '' ),
        ];
        $unfiltered_names[] = $slug;
    }
    $mu_plugins = [];
    foreach ( get_mu_plugins() as $file => $data ) {
        $slug = strpos( $file, '/' ) !== false ? dirname( $file ) : basename( $file, '.php' );
        $row  = [
            'name'    => $slug,
            'title'   => (string) ( $data['Name'] ?? '' ),
            'status'  => 'must-use',
            'version' => (string) ( $data['Version'] ?? '' ),
        ];
        $mu_plugins[]       = $row;
        $plugins[]          = $row;
        $unfiltered_names[] = $slug;
    }
    foreach ( get_dropins() as $file => $data ) {
        $slug = basename( $file, '.php' );
        $plugins[] = [
            'name'    => $slug,
            'title'   => (string) ( $data['Name'] ?? '' ),
            'status'  => 'dropin',
            'version' => (string) ( $data['Version'] ?? '' ),
        ];
        $unfiltered_names[] = $slug;
    }
    if ( defined( 'CC_UNFILTERED_FILE' ) && CC_UNFILTERED_FILE !== '' ) {
        file_put_contents( CC_UNFILTERED_FILE, implode( "\n", $unfiltered_names ) . "\n" );
    }

    $cur_style = (string) get_option( 'stylesheet', '' );
    $cur_tpl   = (string) get_option( 'template', '' );
    $themes    = [];
    foreach ( wp_get_themes() as $slug => $t ) {
        $st = ( $slug === $cur_style ) ? 'active' : ( ( $slug === $cur_tpl && $cur_tpl !== $cur_style ) ? 'parent' : 'inactive' );
        $themes[] = [
            'name'    => (string) $slug,
            'title'   => (string) $t->get( 'Name' ),
            'status'  => $st,
            'version' => (string) $t->get( 'Version' ),
        ];
    }

    // Users: direct SQL matches `wp user list --format=json` without hydrating WP_User objects.
    $role_defs = array_keys( (array) get_option( $wpdb->prefix . 'user_roles', [] ) );
    $role_map  = array_flip( $role_defs );
    $cap_key   = $wpdb->prefix . 'capabilities';
    $u_sql     = is_multisite()
        ? "SELECT u.ID, u.user_login, u.display_name, u.user_email, u.user_registered, m.meta_value AS caps
           FROM {$wpdb->users} u
           INNER JOIN {$wpdb->usermeta} m ON m.user_id = u.ID AND m.meta_key = %s
           ORDER BY u.user_login ASC"
        : "SELECT u.ID, u.user_login, u.display_name, u.user_email, u.user_registered, m.meta_value AS caps
           FROM {$wpdb->users} u
           LEFT JOIN {$wpdb->usermeta} m ON m.user_id = u.ID AND m.meta_key = %s
           ORDER BY u.user_login ASC";
    $users = [];
    foreach ( (array) $wpdb->get_results( $wpdb->prepare( $u_sql, $cap_key ) ) as $u ) {
        $caps  = maybe_unserialize( $u->caps );
        $roles = [];
        if ( is_array( $caps ) ) {
            foreach ( $caps as $rk => $on ) {
                if ( $on && isset( $role_map[ $rk ] ) ) {
                    $roles[] = $rk;
                }
            }
        }
        $users[] = [
            'ID'              => (int) $u->ID,
            'user_login'      => (string) $u->user_login,
            'display_name'    => (string) $u->display_name,
            'user_email'      => (string) $u->user_email,
            'user_registered' => (string) $u->user_registered,
            'roles'           => implode( ', ', $roles ),
        ];
    }

    $emit( 'plugins', json_encode( $plugins, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR ) );
    $emit( 'themes', json_encode( $themes, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR ) );
    $emit( 'mu_plugins', json_encode( $mu_plugins, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR ) );
    $emit( 'core', (string) $wp_version );
    $emit( 'home_url', (string) get_option( 'home', '' ) );
    $emit( 'site_url', (string) get_option( 'siteurl', '' ) );
    $emit( 'users', json_encode( $users, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR ) );
    $emit( 'database_name', defined( 'DB_NAME' ) ? (string) DB_NAME : '' );
    $emit( 'database_username', defined( 'DB_USER' ) ? (string) DB_USER : '' );
    $emit( 'database_password', defined( 'DB_PASSWORD' ) ? (string) DB_PASSWORD : '' );
    $emit( 'subsite_count', is_multisite() ? (string) (int) get_sites( [ 'count' => true, 'number' => 0 ] ) : '' );
    $emit( 'default_role', (string) get_option( 'default_role', '' ) );
    $emit( 'registration', is_multisite() ? (string) get_site_option( 'registration', '' ) : (string) get_option( 'users_can_register', '0' ) );
    $emit( 'token', defined( 'AUTH_KEY' ) ? md5( AUTH_KEY ) : '' );

    $db_size = (int) $wpdb->get_var( "SELECT COALESCE(SUM(data_length + index_length), 0) FROM information_schema.TABLES WHERE table_schema = DATABASE()" );
    $emit( 'db_size', (string) $db_size );

    $sl = $wpdb->get_row( "SELECT (data_length + index_length) AS sz, table_rows AS rws FROM information_schema.TABLES WHERE table_schema = DATABASE() AND table_name LIKE '%captaincore_security_log' LIMIT 1" );
    if ( $sl ) {
        $emit( 'security_log', '{"size":' . (int) $sl->sz . ',"rows":' . (int) $sl->rws . '}' );
    } else {
        $emit( 'security_log', '{"size":0,"rows":0}' );
    }
} )();

// --- wp-config.php redacted rule-scan payload ---
$run_probe( 'wp_config_check', function () {
    $cfg = ABSPATH . 'wp-config.php';
    if ( ! is_file( $cfg ) && is_file( dirname( ABSPATH ) . '/wp-config.php' ) ) {
        $cfg = dirname( ABSPATH ) . '/wp-config.php';
    }
    if ( ! is_file( $cfg ) ) {
        echo 'null';
        return;
    }
    $raw = @file_get_contents( $cfg, false, null, 0, 524288 );
    if ( ! is_string( $raw ) || $raw === '' ) {
        echo 'null';
        return;
    }
    $sha = hash_file( 'sha256', $cfg ) ?: hash( 'sha256', $raw );
    $redacted = preg_replace(
        '/(define\s*\(\s*[\'"][A-Z0-9_]*(?:PASSWORD|PASS|SECRET|SALT|KEY|TOKEN|LICENSE)[A-Z0-9_]*[\'"]\s*,\s*)([\'"])(?:\\\\.|(?!\2).)*\2/i',
        '$1$2REDACTED$2',
        $raw
    );
    echo json_encode( [
        'path'   => 'wp-config.php',
        'sha256' => $sha,
        'size'   => (int) filesize( $cfg ),
        'b64'    => base64_encode( (string) $redacted ),
    ], JSON_UNESCAPED_SLASHES );
}, 'null' );

// --- Database scan (identical to lib/remote-scripts/db-scan; keep in step) ---
define( 'DBSCAN_SINCE', 2 );
define( 'DBSCAN_FULL', false );
define( 'DBSCAN_MAX_ROW', 16384 );
define( 'DBSCAN_MAX_TOTAL', 2097152 );
$run_probe( 'db_scan', function () {
// BEGIN DBSCAN
// db-scan: export candidate rows and fixed facts. Arguments via constants set by the wrapper.
$since     = defined('DBSCAN_SINCE') ? (int) DBSCAN_SINCE : 2;
$full      = defined('DBSCAN_FULL') && DBSCAN_FULL;
$max_row   = defined('DBSCAN_MAX_ROW') ? (int) DBSCAN_MAX_ROW : 16384;
$max_total = defined('DBSCAN_MAX_TOTAL') ? (int) DBSCAN_MAX_TOTAL : 2097152;
global $wpdb;
$out = ['since_days' => $since, 'full' => $full, 'options' => [], 'posts' => [], 'comments' => [], 'postmeta' => [], 'snippets' => [], 'admins' => [],
        'plugins_missing' => [], 'triggers' => [], 'events' => [], 'routines' => [], 'unknown_tables' => [],
        'suspicious_options' => [], 'toolkit_markers' => [], 'stats' => [], 'truncated' => false];
$total = 0;
$cut = function ($s) use ($max_row) {
    $s = (string) $s;
    if (strlen($s) <= $max_row) return $s;
    return substr($s, 0, $max_row - 4096) . "\n/* ...cut... */\n" . substr($s, -4096);
};
$room = function ($len) use (&$total, $max_total, &$out) {
    if ($total + $len > $max_total) { $out['truncated'] = true; return false; }
    $total += $len; return true;
};
// High-signal script/code markers vs noisy CSS hiding markers. Keeping them split
// prevents large theme/builder CSS options from crowding out small injected options.
$high_markers = ['<script', '<iframe', 'eval(', 'base64_decode', 'atob(', 'fromCharCode', 'document.write', '<?php', 'unescape(',
                 'javascript:', 'String.fromCharCode', 'window.location', '\\x2', '\\x3', '\\x6', '\\x7',
                 'gzinflate', 'str_rot13', 'create_function', 'assert(', 'passthru', 'shell_exec'];
$css_markers  = ['display:none', 'visibility:hidden', 'left:-', 'top:-', 'text-indent:-', 'font-size:0', 'opacity:0', 'position:absolute'];
$markers      = array_merge($high_markers, $css_markers);
$like_set = function ($col, $list) use ($wpdb) {
    $parts = [];
    foreach ($list as $m) $parts[] = $wpdb->prepare("$col LIKE %s", '%' . $wpdb->esc_like($m) . '%');
    return '(' . implode(' OR ', $parts) . ')';
};
$like      = function ($col) use ($like_set, $markers) { return $like_set($col, $markers); };
$like_high = function ($col) use ($like_set, $high_markers) { return $like_set($col, $high_markers); };

// Options: always export cron first, then high-signal code/script rows (newest first so
// small recent injections are never dropped behind huge old options), then CSS-marker rows.
// Security plugins store their own signature lists in options; those quote every web shell name.
$skip_names = "option_name NOT LIKE '\\_vp\\_%' AND option_name NOT LIKE 'wordfence%' AND option_name NOT LIKE 'wf%' AND option_name NOT LIKE 'sucuri%' AND option_name NOT LIKE 'itsec%' AND option_name NOT LIKE 'aiowps%' AND option_name NOT LIKE 'cerber%' AND option_name NOT LIKE 'malcare%' AND option_name NOT LIKE 'wpmr%' AND option_name NOT LIKE 'gotmls%' AND option_name NOT LIKE 'quttera%' AND option_name NOT LIKE 'virusdie%' AND option_name NOT LIKE 'shield%' AND option_name NOT LIKE 'icwp%' AND option_name NOT LIKE 'nfw%' AND option_name NOT LIKE 'securi%' AND option_name NOT LIKE 'jetpack_protect%' AND option_name NOT LIKE 'wpseo-gsc%' AND option_name NOT LIKE 'redirection_404%' AND option_name NOT LIKE '%_404_log%'";
$seen_opts = [];
$add_option = function ($r) use ($wpdb, $cut, $room, &$out, &$seen_opts) {
    if (!$r || isset($seen_opts[$r->option_name])) return true;
    $seen_opts[$r->option_name] = true;
    $v = $wpdb->get_var($wpdb->prepare("SELECT option_value FROM {$wpdb->options} WHERE option_name = %s", $r->option_name));
    $v = $cut($v);
    if (!$room(strlen($v))) return false;
    $out['options'][] = ['name' => $r->option_name, 'autoload' => $r->autoload, 'size' => (int) $r->len, 'content' => $v];
    return true;
};
$cron_row = $wpdb->get_row("SELECT option_name, autoload, LENGTH(option_value) AS len FROM {$wpdb->options} WHERE option_name = 'cron' LIMIT 1");
if ($cron_row) $add_option($cron_row);
$rows = $wpdb->get_results("SELECT option_name, autoload, LENGTH(option_value) AS len FROM {$wpdb->options} WHERE $skip_names AND " . $like_high('option_value') . " ORDER BY option_id DESC LIMIT 300");
foreach ($rows as $r) { if (!$add_option($r)) break; }
if (count($out['options']) < 400 && !$out['truncated']) {
    $rem  = 400 - count($out['options']);
    $rows = $wpdb->get_results("SELECT option_name, autoload, LENGTH(option_value) AS len FROM {$wpdb->options} WHERE $skip_names AND " . $like_set('option_value', $css_markers) . " ORDER BY option_id DESC LIMIT $rem");
    foreach ($rows as $r) { if (!$add_option($r)) break; }
}
$out['stats']['options_total'] = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->options}");
$out['stats']['options_exported'] = count($out['options']);
// Option names seen in past injections.
$bad_names = ['%seoinj%', '%html_inject%', '%wp_class_editor%', '%wp_check_hash%', '%wpupdates_hash%', '%_transient_wp_cache_key%', '%wp_head_inject%', '%footer_inject%'];
foreach ($bad_names as $bn) {
    foreach ($wpdb->get_col($wpdb->prepare("SELECT option_name FROM {$wpdb->options} WHERE option_name LIKE %s LIMIT 20", $bn)) as $n) $out['suspicious_options'][] = $n;
}
$out['suspicious_options'] = array_values(array_unique($out['suspicious_options']));
// SMILODON bookkeeping: one option per admin IP it saw, named wp_<md5(ip)> with a Unix
// timestamp value. They survive file-only cleanups. (Its "__"-prefixed config options are
// not used as a tell: Spectra keeps __uagb_* options on thousands of sites.)
$out['toolkit_markers'] = $wpdb->get_col("SELECT option_name FROM {$wpdb->options} WHERE option_name REGEXP '^wp_[a-f0-9]{32}$' AND option_value REGEXP '^[0-9]{9,11}$' LIMIT 100") ?: [];

// Posts and comments: rows with a marker, changed recently (or all, chunked, for --full).
$posts_checked = 0;
if ($full) {
    $max_id = (int) $wpdb->get_var("SELECT MAX(ID) FROM {$wpdb->posts}");
    for ($lo = 0; $lo <= $max_id; $lo += 5000) {
        $hi = $lo + 5000;
        $posts_checked += (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->posts} WHERE ID >= $lo AND ID < $hi");
        $rows = $wpdb->get_results("SELECT ID, post_type, post_status, post_modified, post_title, post_content FROM {$wpdb->posts} WHERE ID >= $lo AND ID < $hi AND post_type NOT IN ('revision') AND " . $like('post_content') . " LIMIT 200");
        foreach ($rows as $r) {
            $c = $cut($r->post_content);
            if (!$room(strlen($c))) break 2;
            $out['posts'][] = ['id' => (int) $r->ID, 'type' => $r->post_type, 'status' => $r->post_status, 'modified' => $r->post_modified, 'title' => substr($r->post_title, 0, 200), 'content' => $c];
        }
        usleep(200000);
    }
} else {
    // post_modified, not post_modified_gmt: drafts keep the GMT column at 0000-00-00.
    $since_sql = $wpdb->prepare("post_modified >= DATE_SUB(NOW(), INTERVAL %d DAY)", $since);
    $posts_checked = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->posts} WHERE $since_sql");
    $rows = $wpdb->get_results("SELECT ID, post_type, post_status, post_modified, post_title, post_content FROM {$wpdb->posts} WHERE $since_sql AND post_type NOT IN ('revision') AND " . $like('post_content') . " LIMIT 300");
    foreach ($rows as $r) {
        $c = $cut($r->post_content);
        if (!$room(strlen($c))) break;
        $out['posts'][] = ['id' => (int) $r->ID, 'type' => $r->post_type, 'status' => $r->post_status, 'modified' => $r->post_modified, 'title' => substr($r->post_title, 0, 200), 'content' => $c];
    }
}
$out['stats']['posts_checked'] = $posts_checked;
$out['stats']['posts_exported'] = count($out['posts']);
$csince = $full ? '1=1' : $wpdb->prepare("comment_date >= DATE_SUB(NOW(), INTERVAL %d DAY)", $since);
$rows = $wpdb->get_results("SELECT comment_ID, comment_post_ID, comment_approved, comment_date_gmt, comment_author_url, comment_content FROM {$wpdb->comments} WHERE $csince AND " . $like('comment_content') . " LIMIT 200");
foreach ($rows as $r) {
    $c = $cut($r->comment_content);
    if (!$room(strlen($c))) break;
    $out['comments'][] = ['id' => (int) $r->comment_ID, 'post' => (int) $r->comment_post_ID, 'approved' => $r->comment_approved, 'date' => $r->comment_date_gmt, 'url' => $r->comment_author_url, 'content' => $c];
}
$out['stats']['comments_exported'] = count($out['comments']);

// Postmeta: indexed join against recently modified posts (or known builder/script keys
// on --full) so page builders (Elementor _elementor_data, Beaver Builder, header/footer
// script meta) are scanned without full-scanning multi-million-row WooCommerce postmeta.
if (!$out['truncated']) {
    if ($full) {
        $pm_keys = "'_elementor_data','_fl_builder_data','_et_pb_old_content','header_scripts','footer_scripts','_header_script','_footer_script'";
        $pm_rows = $wpdb->get_results("SELECT meta_id, post_id, meta_key, LENGTH(meta_value) AS len, meta_value FROM {$wpdb->postmeta} WHERE meta_key IN ($pm_keys) AND " . $like_high('meta_value') . " ORDER BY meta_id DESC LIMIT 200");
    } else {
        $since_sql_pm = $wpdb->prepare("p.post_modified >= DATE_SUB(NOW(), INTERVAL %d DAY)", $since);
        $pm_rows = $wpdb->get_results("SELECT pm.meta_id, pm.post_id, pm.meta_key, LENGTH(pm.meta_value) AS len, pm.meta_value FROM {$wpdb->postmeta} pm INNER JOIN {$wpdb->posts} p ON p.ID = pm.post_id WHERE $since_sql_pm AND p.post_type NOT IN ('revision') AND pm.meta_key NOT LIKE '\\_oembed%' AND " . $like_high('pm.meta_value') . " ORDER BY pm.meta_id DESC LIMIT 200");
    }
    foreach ((array) $pm_rows as $r) {
        $c = $cut($r->meta_value);
        if (!$room(strlen($c))) break;
        $out['postmeta'][] = ['meta_id' => (int) $r->meta_id, 'post_id' => (int) $r->post_id, 'key' => (string) $r->meta_key, 'size' => (int) $r->len, 'content' => $c];
    }
}
$out['stats']['postmeta_exported'] = count($out['postmeta']);

// Snippet plugins (Code Snippets, Header Footer Code Manager): small tables holding executable PHP/JS.
if (!$out['truncated']) {
    $sn_table = $wpdb->prefix . 'snippets';
    if ($wpdb->get_var($wpdb->prepare('SHOW TABLES LIKE %s', $sn_table)) === $sn_table) {
        foreach ((array) $wpdb->get_results("SELECT id, name, code FROM `{$sn_table}` WHERE active = 1 AND " . $like_high('code') . " ORDER BY id DESC LIMIT 100") as $r) {
            $c = $cut($r->code);
            if (!$room(strlen($c))) break;
            $out['snippets'][] = ['table' => 'snippets', 'id' => (int) $r->id, 'name' => substr((string) $r->name, 0, 120), 'content' => $c];
        }
    }
    $hfcm_table = $wpdb->prefix . 'hfcm_scripts';
    if (!$out['truncated'] && $wpdb->get_var($wpdb->prepare('SHOW TABLES LIKE %s', $hfcm_table)) === $hfcm_table) {
        foreach ((array) $wpdb->get_results("SELECT script_id AS id, name, snippet AS code FROM `{$hfcm_table}` WHERE status = 'active' AND " . $like_high('snippet') . " ORDER BY script_id DESC LIMIT 100") as $r) {
            $c = $cut($r->code);
            if (!$room(strlen($c))) break;
