#!/usr/bin/env bash

#
#   Shows file changes between Quicksaves.
#
#   `captaincore quicksave show-changes <site> <commit-hash> [<match>]`
#

if [ ${#@} -lt 2 ]; then
  echo -e "${COLOR_RED}Error:${COLOR_NORMAL} Please specify a <site> and <commit-hash>."
  exit
fi

while read config; do
  if [[ "$config" == "Error:"* ]]; then
    continue
  fi
  [[ ${config%%=*} =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  declare "$config"
done <<< "$(captaincore config fetch --captain-id=$CAPTAIN_ID)"

site=$1
commit=$2
match=$3

run_command() {

	# Extract environment
	# The site's own name for the environment (production, staging or any other it has).
	# Unknown means stop: guessing production would act on the wrong site.
	environment=$(captaincore site get "$site" --field=environment --captain-id=$CAPTAIN_ID)
	if [[ -z "$environment" ]]; then
		echo "Error: $site not found." >&2
		exit 1
	fi

	IFS=$'\n'$'\r'; for line in $(captaincore site get $site --bash --captain-id=$CAPTAIN_ID); do [[ ${line%%=*} =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && declare "$line"; done; unset IFS

	# Return error if domain not found
	if [[ "$domain" == "" ]] || [[ "$site" == "" ]]; then
		echo "Can't locate website for site $site"
		return
	fi

	if [ ! -d "$path/${site}_${site_id}/${environment}/quicksave/" ]; then
		echo -e "Error: Unable to locate Quicksave."
		return
	fi

	cd $path/${site}_${site_id}/${environment}/quicksave/
	git_show=$( git show $commit --name-status --format= $match )
	echo "$git_show"

}

run_command
