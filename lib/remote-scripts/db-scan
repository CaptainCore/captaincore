#!/usr/bin/env bash
#
#   Database scan: export the rows of a WordPress database that could carry an
#   injection, plus the fixed facts a scanner needs, as one JSON document.
#   The judging happens on the core server: sync-data writes the exported
#   rows out as files and runs the malware rules over them, and applies the
#   fixed checks (triggers, missing plugin files, new administrators).
#
#   Usage (on the site, WordPress root):
#     bash db-scan [--since=DAYS] [--full] [--max-row=BYTES] [--max-total=BYTES]
#
#   --since=DAYS   posts and comments modified in the last DAYS days (default 2).
#                  Options, cron, users, triggers and tables are always read in full.
#   --full         every post and comment, in id-ranged chunks with a pause between
#                  them (the weekly sweep).
#
#   What is exported:
#     options     rows whose value contains a script or code marker (LIKE prefilters
#                 in SQL, so most of the table never leaves MySQL); the cron array;
#                 option names known from past injections
#     posts       same markers, post_content and post_title, modified since --since
#     comments    same markers on comment_content
#     admins      every administrator (and super admin on multisite)
#     plugins     active plugins whose file is missing on disk
#     triggers    triggers, events and stored routines in the database
#     tables      tables outside the core set and the known plugin prefixes
#
#   Row contents are cut to --max-row bytes (head and tail kept), the whole export
#   to --max-total. The nightly copy inside fetch-site-data is this same PHP;
#   keep the two in step.
#
#   Requires WP-CLI. Output: one JSON object on stdout.

SINCE=2; FULL=0; MAX_ROW=16384; MAX_TOTAL=2097152
for arg in "$@"; do
  case "$arg" in
    --since=*) SINCE="${arg#*=}" ;;
    --full) FULL=1 ;;
    --max-row=*) MAX_ROW="${arg#*=}" ;;
    --max-total=*) MAX_TOTAL="${arg#*=}" ;;
  esac
done

read -r -d '' DB_SCAN_PHP << 'DBSCANEOF'
<?php
// db-scan: export candidate rows and fixed facts. Arguments via constants set by the wrapper.
$since     = defined('DBSCAN_SINCE') ? (int) DBSCAN_SINCE : 2;
$full      = defined('DBSCAN_FULL') && DBSCAN_FULL;
$max_row   = defined('DBSCAN_MAX_ROW') ? (int) DBSCAN_MAX_ROW : 16384;
$max_total = defined('DBSCAN_MAX_TOTAL') ? (int) DBSCAN_MAX_TOTAL : 2097152;
global $wpdb;
$out = ['since_days' => $since, 'full' => $full, 'options' => [], 'posts' => [], 'comments' => [], 'admins' => [],
        'plugins_missing' => [], 'triggers' => [], 'events' => [], 'routines' => [], 'unknown_tables' => [],
        'suspicious_options' => [], 'toolkit_markers' => [], 'stats' => [], 'truncated' => false];
$total = 0;
$cut = function ($s) use ($max_row) {
    $s = (string) $s;
    if (strlen($s) <= $max_row) return $s;
    return substr($s, 0, $max_row - 4096) . "\n/* ...cut... */\n" . substr($s, -4096);
};
$room = function ($len) use (&$total, $max_total, &$out) {
    if ($total + $len > $max_total) { $out['truncated'] = true; return false; }
    $total += $len; return true;
};
// Markers that make a row worth reading. Each is a case-insensitive LIKE.
$markers = ['<script', '<iframe', 'eval(', 'base64_decode', 'atob(', 'fromCharCode', 'document.write', '<?php', 'unescape(',
            'javascript:', 'String.fromCharCode', 'window.location', 'display:none', 'visibility:hidden', '\\x2', '\\x3', '\\x6', '\\x7',
            'gzinflate', 'str_rot13', 'create_function', 'assert(', 'passthru', 'shell_exec',
            'left:-', 'top:-', 'text-indent:-', 'font-size:0', 'opacity:0', 'position:absolute'];
$like = function ($col) use ($markers, $wpdb) {
    $parts = [];
    foreach ($markers as $m) $parts[] = $wpdb->prepare("$col LIKE %s", '%' . $wpdb->esc_like($m) . '%');
    return '(' . implode(' OR ', $parts) . ')';
};

// Options: every row with a marker, cut to size. The cron array is always included.
// Security plugins store their own signature lists in options; those quote every web shell name.
$skip_names = "option_name NOT LIKE '\\_vp\\_%' AND option_name NOT LIKE 'wordfence%' AND option_name NOT LIKE 'wf%' AND option_name NOT LIKE 'sucuri%' AND option_name NOT LIKE 'itsec%' AND option_name NOT LIKE 'aiowps%' AND option_name NOT LIKE 'cerber%' AND option_name NOT LIKE 'malcare%' AND option_name NOT LIKE 'wpmr%' AND option_name NOT LIKE 'gotmls%' AND option_name NOT LIKE 'quttera%' AND option_name NOT LIKE 'virusdie%' AND option_name NOT LIKE 'shield%' AND option_name NOT LIKE 'icwp%' AND option_name NOT LIKE 'nfw%' AND option_name NOT LIKE 'securi%' AND option_name NOT LIKE 'jetpack_protect%'";
$rows = $wpdb->get_results("SELECT option_name, autoload, LENGTH(option_value) AS len FROM {$wpdb->options} WHERE $skip_names AND (" . $like('option_value') . " OR option_name = 'cron') ORDER BY len DESC LIMIT 400");
foreach ($rows as $r) {
    $v = $wpdb->get_var($wpdb->prepare("SELECT option_value FROM {$wpdb->options} WHERE option_name = %s", $r->option_name));
    $v = $cut($v);
    if (!$room(strlen($v))) break;
    $out['options'][] = ['name' => $r->option_name, 'autoload' => $r->autoload, 'size' => (int) $r->len, 'content' => $v];
}
$out['stats']['options_total'] = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->options}");
$out['stats']['options_exported'] = count($out['options']);
// Option names seen in past injections.
$bad_names = ['%seoinj%', '%html_inject%', '%wp_class_editor%', '%wp_check_hash%', '%wpupdates_hash%', '%_transient_wp_cache_key%', '%wp_head_inject%', '%footer_inject%'];
foreach ($bad_names as $bn) {
    foreach ($wpdb->get_col($wpdb->prepare("SELECT option_name FROM {$wpdb->options} WHERE option_name LIKE %s LIMIT 20", $bn)) as $n) $out['suspicious_options'][] = $n;
}
$out['suspicious_options'] = array_values(array_unique($out['suspicious_options']));
// SMILODON bookkeeping: one option per admin IP it saw, named wp_<md5(ip)> with a Unix
// timestamp value. They survive file-only cleanups. (Its "__"-prefixed config options are
// not used as a tell: Spectra keeps __uagb_* options on thousands of sites.)
$out['toolkit_markers'] = $wpdb->get_col("SELECT option_name FROM {$wpdb->options} WHERE option_name REGEXP '^wp_[a-f0-9]{32}$' AND option_value REGEXP '^[0-9]{9,11}$' LIMIT 100") ?: [];

// Posts and comments: rows with a marker, changed recently (or all, chunked, for --full).
$posts_checked = 0;
if ($full) {
    $max_id = (int) $wpdb->get_var("SELECT MAX(ID) FROM {$wpdb->posts}");
    for ($lo = 0; $lo <= $max_id; $lo += 5000) {
        $hi = $lo + 5000;
        $posts_checked += (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->posts} WHERE ID >= $lo AND ID < $hi");
        $rows = $wpdb->get_results("SELECT ID, post_type, post_status, post_modified, post_title, post_content FROM {$wpdb->posts} WHERE ID >= $lo AND ID < $hi AND post_type NOT IN ('revision') AND " . $like('post_content') . " LIMIT 200");
        foreach ($rows as $r) {
            $c = $cut($r->post_content);
            if (!$room(strlen($c))) break 2;
            $out['posts'][] = ['id' => (int) $r->ID, 'type' => $r->post_type, 'status' => $r->post_status, 'modified' => $r->post_modified, 'title' => substr($r->post_title, 0, 200), 'content' => $c];
        }
        usleep(200000);
    }
} else {
    // post_modified, not post_modified_gmt: drafts keep the GMT column at 0000-00-00.
    $since_sql = $wpdb->prepare("post_modified >= DATE_SUB(NOW(), INTERVAL %d DAY)", $since);
    $posts_checked = (int) $wpdb->get_var("SELECT COUNT(*) FROM {$wpdb->posts} WHERE $since_sql");
    $rows = $wpdb->get_results("SELECT ID, post_type, post_status, post_modified, post_title, post_content FROM {$wpdb->posts} WHERE $since_sql AND post_type NOT IN ('revision') AND " . $like('post_content') . " LIMIT 300");
    foreach ($rows as $r) {
        $c = $cut($r->post_content);
        if (!$room(strlen($c))) break;
        $out['posts'][] = ['id' => (int) $r->ID, 'type' => $r->post_type, 'status' => $r->post_status, 'modified' => $r->post_modified, 'title' => substr($r->post_title, 0, 200), 'content' => $c];
    }
}
$out['stats']['posts_checked'] = $posts_checked;
$out['stats']['posts_exported'] = count($out['posts']);
$csince = $full ? '1=1' : $wpdb->prepare("comment_date >= DATE_SUB(NOW(), INTERVAL %d DAY)", $since);
$rows = $wpdb->get_results("SELECT comment_ID, comment_post_ID, comment_approved, comment_date_gmt, comment_author_url, comment_content FROM {$wpdb->comments} WHERE $csince AND " . $like('comment_content') . " LIMIT 200");
foreach ($rows as $r) {
    $c = $cut($r->comment_content);
    if (!$room(strlen($c))) break;
    $out['comments'][] = ['id' => (int) $r->comment_ID, 'post' => (int) $r->comment_post_ID, 'approved' => $r->comment_approved, 'date' => $r->comment_date_gmt, 'url' => $r->comment_author_url, 'content' => $c];
}
$out['stats']['comments_exported'] = count($out['comments']);

// Administrators, including super admins on multisite.
$admins = [];
foreach (get_users(['role' => 'administrator', 'fields' => ['ID', 'user_login', 'user_email', 'user_registered']]) as $u) {
    $admins[$u->ID] = ['id' => (int) $u->ID, 'login' => $u->user_login, 'email' => $u->user_email, 'registered' => $u->user_registered, 'super' => false];
}
if (is_multisite()) {
    foreach (get_super_admins() as $login) {
        $u = get_user_by('login', $login);
        if ($u) $admins[$u->ID] = ['id' => (int) $u->ID, 'login' => $u->user_login, 'email' => $u->user_email, 'registered' => $u->user_registered, 'super' => true];
    }
}
$out['admins'] = array_values($admins);

// Active plugins whose main file is gone: a loader that was deleted but left
// registered, or an entry pointing outside plugins/.
$active = (array) get_option('active_plugins', []);
if (is_multisite()) $active = array_merge($active, array_keys((array) get_site_option('active_sitewide_plugins', [])));
foreach ($active as $p) {
    if (!is_string($p)) continue;
    if (!file_exists(WP_PLUGIN_DIR . '/' . $p) || strpos($p, '..') !== false) $out['plugins_missing'][] = $p;
}

// Triggers, events and routines: WordPress never creates them.
$db = DB_NAME;
// Table names WordPress core creates, and prefixes the common plugins use (shared by the
// trigger and unknown-table checks).
$core = ['commentmeta', 'comments', 'links', 'options', 'postmeta', 'posts', 'termmeta', 'term_relationships', 'term_taxonomy', 'terms', 'usermeta', 'users',
         'blogmeta', 'blogs', 'blog_versions', 'registration_log', 'signups', 'site', 'sitemeta'];
$GLOBALS['dbscan_known_prefixes'] = $known = ['actionscheduler_', 'woocommerce_', 'wc_', 'gf_', 'rg_', 'yoast_', 'wpforms_', 'e_', 'elementor', 'aioseo_', 'rank_math', 'seopress', 'redirection_', 'cleantalk',
          'smush', 'ewwwio', 'mailchimp', 'mc4wp', 'wpcode', 'searchwp', 'simple_history', 'snippets', 'litespeed', 'wpml', 'icl_', 'pmxi_', 'pmxe_', 'frm_', 'nf3_', 'cf7', 'wpmailsmtp',
          'wsal_', 'defender', 'ac_', 'admin_columns', 'tec_', 'wp_rocket', 'wprocket', 'edd_', 'affiliate_wp', 'affiliatewp', 'learndash', 'ld_', 'mepr_', 'pms_', 'um_', 'bp_', 'wpsc_',
          'captaincore_', 'gravitysmtp_', 'iwp_', 'mlw_', 'fluentform', 'fluent_', 'wpr_', 'wpr_rocket', 'wpfm_', 'wpstg', 'aiowps_', 'aioseo_', 'wpforo_', 'pods', 'ninja_', 'nf3_', 'give_', 'tribe_', 'trp_', 'wc_order', 'wcpdf', 'bv_', 'blc_', 'wpvivid_', 'ai1wm_', 'duplicator_', 'et_', 'wpmm_', 'dsb_', 'yop_', 'wpp_', 'ppress_', 'wpjb_', 'wpsp_', 'wpstream_', 'wpcf7_', 'cf_', 'wpdm_', 'wpml_', 'polylang', 'cmplz_', 'termmeta', 'hustle_', 'wpgmza_', 'wpgmp_', 'ms_', 'srs_', 'wpil_', 'wp_lw', 'litespeed_', 'wpforms_', 'gv_', 'gp_', 'wpai_', 'sbi_', 'cff_', 'ctf_', 'wp_defender', 'wd_', 'wpca_', 'ahc_', 'wsm_', 'cn_', 'wp_shortpixel', 'shortpixel', 'wpo_', 'w3tc_', 'rsvp', 'evf_', 'ur_', 'wpr_', 'wp_smush', 'smush_', 'cc_', 'ahm_', 'fsb_', 'berocket', 'yith_', 'wt_', 'ws_ft', 'w3tc', 'hustle', 'forminator', 'pp_', 'branda', 'wpmudev', 'sib_', 'mailpoet', 'burst_', 'rsssl', 'aiowps', 'wfls_', 'wf', 'itsec_', 'cerber_', 'gla_', 'jetpack_', 'wc_admin', 'woo'];
// Triggers on a plugin's own tables (Bookly, WC Blacklist Manager and the like) are that
// plugin's; only triggers on core tables or unknown tables are reported. The known plugin
// prefixes are the same list the unknown-table check uses below.
$out['triggers'] = [];
foreach ($wpdb->get_results($wpdb->prepare("SELECT TRIGGER_NAME, EVENT_OBJECT_TABLE FROM INFORMATION_SCHEMA.TRIGGERS WHERE TRIGGER_SCHEMA = %s", $db)) as $tr) {
    $tbl = preg_replace('/^' . preg_quote($wpdb->prefix, '/') . '(\d+_)?/', '', $tr->EVENT_OBJECT_TABLE);
    $plugin_table = false;
    foreach ($GLOBALS['dbscan_known_prefixes'] ?? [] as $k) if (strpos($tbl, $k) === 0) { $plugin_table = true; break; }
    if (!$plugin_table) $out['triggers'][] = $tr->TRIGGER_NAME . ' on ' . $tr->EVENT_OBJECT_TABLE;
}
$out['events']   = $wpdb->get_col($wpdb->prepare("SELECT EVENT_NAME FROM INFORMATION_SCHEMA.EVENTS WHERE EVENT_SCHEMA = %s", $db)) ?: [];
$out['routines'] = $wpdb->get_col($wpdb->prepare("SELECT ROUTINE_NAME FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_SCHEMA = %s", $db)) ?: [];

// Tables outside the core set and the common plugin prefixes.
$prefix = $wpdb->prefix;
foreach ($wpdb->get_col("SHOW TABLES") as $t) {
    if (strpos($t, $prefix) !== 0) { $out['unknown_tables'][] = $t; continue; }
    $rest = substr($t, strlen($prefix));
    $rest_ms = preg_replace('/^\d+_/', '', $rest); // multisite blog prefix
    if (in_array($rest_ms, $core, true)) continue;
    $ok = false;
    foreach ($known as $k) if (strpos($rest_ms, $k) === 0) { $ok = true; break; }
    if (!$ok) $out['unknown_tables'][] = $t;
}
$out['unknown_tables'] = array_slice($out['unknown_tables'], 0, 100);
$out['stats']['bytes'] = $total;
echo json_encode($out, JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR);
DBSCANEOF

php_defs="define('DBSCAN_SINCE', $SINCE); define('DBSCAN_FULL', $( [ "$FULL" = 1 ] && echo true || echo false )); define('DBSCAN_MAX_ROW', $MAX_ROW); define('DBSCAN_MAX_TOTAL', $MAX_TOTAL);"
result=$( { echo "<?php $php_defs ?>"; echo "$DB_SCAN_PHP"; } | wp eval-file - --skip-themes --skip-plugins 2>/dev/null )
if [ -z "$result" ]; then
  echo '{"error":"db-scan produced no output (wp eval-file failed)"}'
  exit 1
fi
echo "$result"
