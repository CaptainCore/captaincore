    my %trailer = (jpg => ["\xff\xd9", "JPEG EOI"], jpeg => ["\xff\xd9", "JPEG EOI"], png => ["IEND\xaeB`\x82", "PNG IEND"], gif => ["\x3b", "GIF trailer"]);
    if (my $t = $trailer{$ext}) {
        my ($marker, $label) = @$t; my $pos = rindex($tail, $marker);
        my $trail = $pos < 0 ? -1 : length($tail) - $pos - length($marker);
        if ($trail < 0 || $trail > 64) {
            my $detail = $trail < 0 ? "no $label within the last 16 KB" : "$trail bytes after $label";
            my $after = $trail < 0 ? $tail : substr($tail, $pos + length($marker));
            next if $after =~ /SEFT\z/ || $after =~ /Samsung_Capture_Info|Image_UTC_Data|PhotoEditor_Re_Edit_Data|Original_Path_Hash_Key/;
            if ($after =~ /(<\?php|$eval_re|base64_decode|\$_(?:POST|GET|REQUEST|COOKIE))/ || $has_b64->($after)) { $report->("CRITICAL", "APPENDED_PAYLOAD", $detail); }
            elsif ($trail < 0 || $trail <= 4096) { $report->("MEDIUM", "TRAILING_DATA", "$detail (no code or base64 in it: phone cameras append metadata after the image, edited photos carry a second image)"); }
            else { $report->("HIGH", "TRAILING_DATA", $detail); }
            next;
        }
    }
    if ($ext =~ /^(jpe?g|png|gif|webp|ico|bmp|tiff?|pdf|mp4|m4v|mov|m4a|mp3|wav|ogg|webm|avi)$/) {
        my $re = $ext eq "pdf" ? qr/<\?php|base64_decode\(|shell_exec\(|\$_(?:POST|GET|REQUEST|COOKIE)\[/ : $code_re;
        if (($head . "\n" . $tail) =~ /($re)/) { $report->("CRITICAL", "CODE_IN_MEDIA", "contains $1"); next; }
    }
    if ($ext eq "svg" && $size <= 2097152) {
        seek($fh, 0, 0); local $/; my $svg = <$fh>;
        if ($svg =~ /(<script|\son[a-z]+\s*=|javascript:|<foreignObject|<iframe|<embed)/i) { $report->("HIGH", "SVG_ACTIVE", "SVG contains $1"); }
    }
    close $fh;
    END { print "[" . join(",", @out) . "]\n"; }
  ' 2>/dev/null )
  [ -z "$media_payloads_json" ] && media_payloads_json="[]"
fi
echo "media_payloads:$(trim "$media_payloads_json")"
) > "$tmpdir/w2.out" &
pid2=$!

# ----------------------------------------------------------------------------
# Worker 3: Plugin checksum verification (mostly HTTPS waits to wordpress.org)
# ----------------------------------------------------------------------------
(
plugin_verify_checksums_response=$( wp plugin verify-checksums --all --skip-themes --skip-plugins --skip-packages 2>&1 )
plugin_modified_entries=""
plugin_skipped_count=0

while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    [[ "$line" == "plugin_name"$'\t'* ]] && continue
    case "$line" in
        "Warning: Couldn't fetch response from"*) ;;
        "Warning: Could not retrieve the checksums"*) plugin_skipped_count=$((plugin_skipped_count + 1)) ;;
        "Warning: Plugin "*"doesn't provide a readme.txt"*) plugin_skipped_count=$((plugin_skipped_count + 1)) ;;
        "Success:"*|"Error:"*) ;;
        *$'\t'*$'\t'*)
            slug="${line%%$'\t'*}"
            rest="${line#*$'\t'}"
            file="${rest%%$'\t'*}"
            message="${rest#*$'\t'}"
            slug_esc=$( json_escape "$slug" )
            file_esc=$( json_escape "$file" )
            message_esc=$( json_escape "$message" )
            entry="{\"slug\":\"${slug_esc}\",\"file\":\"${file_esc}\",\"message\":\"${message_esc}\"}"
            plugin_modified_entries="${plugin_modified_entries:+$plugin_modified_entries,}${entry}"
            ;;
    esac
done <<< "$plugin_verify_checksums_response"

if [[ -n "$plugin_modified_entries" ]]; then
    plugin_checksum_status="fail"
else
    plugin_checksum_status="pass"
fi
echo "plugin_checksum_details:{\"status\":\"${plugin_checksum_status}\",\"modified\":[${plugin_modified_entries}],\"skipped_count\":${plugin_skipped_count}}"
) > "$tmpdir/w3.out" &
pid3=$!

# ----------------------------------------------------------------------------
# Worker 4: Parallelized component_hashes + mu_plugin_files + hidden_plugins boot
# ----------------------------------------------------------------------------
(
hash_directory() {
    local dir="$1"
    {
        find "$dir" -type f \
            ! -path '*/node_modules/*' \
            ! -path '*/.git/*' \
            ! -name .DS_Store \
            ! -name error_log \
            -exec sha256sum {} + 2>/dev/null
        find "$dir" -type l \
            ! -path '*/node_modules/*' \
            ! -path '*/.git/*' \
            2>/dev/null | while IFS= read -r link; do
                target=$(readlink "$link")
                echo "$(echo -n "SYMLINK:${target}" | sha256sum | awk '{print $1}')  ${link}"
            done
    } | LC_ALL=C sort -k2 | sha256sum | awk '{print $1}'
}

ch_dir="$tmpdir/ch"
mkdir -p "$ch_dir"

pushd "$wp_content" > /dev/null 2>&1

# Run up to 4 component directory hashes concurrently (bit-for-bit identical hashes)
active_jobs=0
idx=0
wait_slot() {
    active_jobs=$((active_jobs + 1))
    if [ "$active_jobs" -ge 4 ]; then
        wait -n 2>/dev/null || wait
        active_jobs=$((active_jobs - 1))
    fi
}

if [[ -d "plugins" ]]; then
    for dir in plugins/*/; do
        [[ -d "$dir" ]] || continue
        idx=$((idx + 1))
        (
            slug=$(basename "$dir")
            h=$(hash_directory "$dir")
            printf '"%s":"%s"\n' "$slug" "$h" > "$ch_dir/$(printf '%05d' $idx).kv"
        ) &
        wait_slot
    done
fi

if [[ -d "themes" ]]; then
    for dir in themes/*/; do
        [[ -d "$dir" ]] || continue
        idx=$((idx + 1))
        (
            slug=$(basename "$dir")
            h=$(hash_directory "$dir")
            printf '"%s":"%s"\n' "$slug" "$h" > "$ch_dir/$(printf '%05d' $idx).kv"
        ) &
        wait_slot
    done
fi

if [[ -d "mu-plugins" ]]; then
    for phpfile in mu-plugins/*.php; do
        [[ -f "$phpfile" ]] || continue
        idx=$((idx + 1))
        (
            slug=$(basename "$phpfile" .php)
            component_file_hashes=$(
                sha256sum "$phpfile" 2>/dev/null
                if [[ -d "mu-plugins/$slug" ]]; then
                    find "mu-plugins/$slug" -type f \
                        ! -path '*/node_modules/*' ! -path '*/.git/*' \
                        ! -name .DS_Store ! -name error_log \
                        -exec sha256sum {} + 2>/dev/null
                    find "mu-plugins/$slug" -type l \
                        ! -path '*/node_modules/*' ! -path '*/.git/*' \
                        2>/dev/null | while IFS= read -r link; do
                            target=$(readlink "$link")
                            echo "$(echo -n "SYMLINK:${target}" | sha256sum | awk '{print $1}')  ${link}"
                        done
                fi
                for companion in mu-plugins/${slug}.*; do
                    [[ -f "$companion" && "$companion" != "$phpfile" ]] || continue
                    sha256sum "$companion" 2>/dev/null
                done
            )
            h=$(echo "$component_file_hashes" | grep -v '^$' | LC_ALL=C sort -k2 | sha256sum | awk '{print $1}')
            printf '"mu:%s":"%s"\n' "$slug" "$h" > "$ch_dir/$(printf '%05d' $idx).kv"
        ) &
        wait_slot
    done
fi

wait

component_hashes="{"
first=true
for kv in "$ch_dir"/*.kv; do
    [[ -f "$kv" ]] || continue
    line=$(cat "$kv")
    [[ -z "$line" ]] && continue
    if [[ "$first" == true ]]; then first=false; else component_hashes+=","; fi
    component_hashes+="$line"
done
component_hashes+="}"
echo "component_hashes:${component_hashes}"

# MU-plugin file listing (root-level files and directories only)
mu_plugin_files="{"
mu_first=true
if [[ -d "mu-plugins" ]]; then
    for entry in mu-plugins/*; do
        [[ -e "$entry" ]] || continue
        base=$(basename "$entry")
        [[ "$base" == ".DS_Store" ]] && continue
        if [[ "$mu_first" == true ]]; then mu_first=false; else mu_plugin_files+=","; fi
        if [[ -d "$entry" ]]; then
            mu_plugin_files+="\"${base}/\":true"
        else
            mu_plugin_files+="\"${base}\":true"
        fi
    done
fi
mu_plugin_files+="}"
echo "mu_plugin_files:${mu_plugin_files}"
popd > /dev/null 2>&1

# Filtered plugin list (with plugin code running) for hidden_plugins diff
wp plugin list --field=name --skip-themes --skip-packages 2>/dev/null > "$tmpdir/filtered_plugins.txt"
) > "$tmpdir/w4.out" &
pid4=$!

wait "$pid1" "$pid2" "$pid3" "$pid4"

# Compute hidden_plugins diff cleanly once Worker 1 and Worker 4 have both finished
hidden_plugins_json="[]"
if [ -s "$tmpdir/filtered_plugins.txt" ] && [ -s "$tmpdir/unfiltered_plugins.txt" ]; then
    hidden_names=$( comm -23 <(sort -u "$tmpdir/unfiltered_plugins.txt") <(sort -u "$tmpdir/filtered_plugins.txt") )
    if [ -n "$hidden_names" ]; then
        hidden_plugins_json=$( echo "$hidden_names" | python3 -c 'import json,sys; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))' 2>/dev/null || echo "$hidden_names" | awk 'BEGIN{printf "["} {printf "%s\"%s\"", (NR>1?",":""), $0} END{print "]"}' )
    fi
fi

cat "$tmpdir/w1.out" "$tmpdir/w2.out" "$tmpdir/w3.out" "$tmpdir/w4.out"
echo "hidden_plugins:$(trim "$hidden_plugins_json")"
