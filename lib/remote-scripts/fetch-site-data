// --- Premium plugin licenses ---
$run_probe( 'licenses', function () {
// Runs with --skip-plugins: reads what each plugin stored, never calls a vendor.
$active = (array) get_option( 'active_plugins', [] );
if ( is_multisite() ) {
    $active = array_merge( $active, array_keys( (array) get_site_option( 'active_sitewide_plugins', [] ) ) );
}
$slugs = [];
foreach ( $active as $file ) {
    $slugs[ strtok( (string) $file, '/' ) ] = (string) $file;
}

// Address without protocol, leading www. or trailing slash, the way ACF and Crocoblock compare.
$normalize = function ( $url ) {
    $url = strtolower( preg_replace( '#^https?://#i', '', trim( (string) $url ) ) );
    if ( strpos( $url, 'www.' ) === 0 ) {
        $url = substr( $url, 4 );
    }
    return rtrim( $url, '/' );
};
$home    = $normalize( get_option( 'home' ) );
$date    = function ( $ts ) { return $ts ? gmdate( 'Y-m-d H:i:s', (int) $ts ) : ''; };
$results = [];
$covered = [];

// Elementor Pro: the status cached from my.elementor.com. The cache is refreshed only while
// an administrator loads wp-admin, so cached_until tells how old it is.
if ( isset( $slugs['elementor-pro'] ) ) {
    $covered['elementor-pro'] = true;
    $key   = (string) get_option( 'elementor_pro_license_key', '' );
    $cache = get_option( '_elementor_pro_license_v2_data' );
    $data  = is_array( $cache ) && isset( $cache['value'] ) ? json_decode( (string) $cache['value'], true ) : null;
    $entry = [ 'plugin' => 'elementor-pro', 'key' => $key === '' ? 'missing' : 'present' ];
    if ( $key === '' ) {
        $entry['status'] = 'missing';
        $entry['ok']     = false;
    } elseif ( ! is_array( $data ) ) {
        $entry['status'] = 'unknown';
        $entry['ok']     = null;
    } elseif ( ! empty( $data['success'] ) ) {
        $entry['status'] = 'valid';
        $entry['ok']     = true;
    } else {
        $entry['status'] = (string) ( $data['error'] ?? $data['license'] ?? 'invalid' );
        // A failed or locked request says nothing about the license.
        $entry['ok']     = in_array( $entry['status'], [ 'http_error', 'request_locked' ], true ) ? null : false;
    }
    if ( is_array( $data ) && ! empty( $data['expires'] ) ) {
        $entry['expires'] = (string) $data['expires'];
    }
    if ( is_array( $cache ) && ! empty( $cache['timeout'] ) ) {
        $entry['cached_until'] = $date( $cache['timeout'] );
    }
    $results[] = $entry;
}

// ACF Pro: the key and the address it was activated for, base64 serialized.
if ( isset( $slugs['advanced-custom-fields-pro'] ) ) {
    $covered['advanced-custom-fields-pro'] = true;
    $raw     = get_option( 'acf_pro_license' );
    $license = is_string( $raw ) && $raw !== '' ? @unserialize( base64_decode( $raw ), [ 'allowed_classes' => false ] ) : null;
    $key     = defined( 'ACF_PRO_LICENSE' ) ? (string) ACF_PRO_LICENSE : (string) ( is_array( $license ) ? ( $license['key'] ?? '' ) : '' );
    $status  = get_option( 'acf_pro_license_status' );
    $state   = is_array( $status ) ? (string) ( $status['status'] ?? '' ) : '';
    $entry   = [ 'plugin' => 'advanced-custom-fields-pro', 'key' => $key === '' ? 'missing' : 'present' ];
    $url     = is_array( $license ) ? (string) ( $license['url'] ?? '' ) : '';
    if ( $key === '' ) {
        $entry['status'] = 'missing';
        $entry['ok']     = false;
    } elseif ( $url !== '' && $normalize( $url ) !== $home ) {
        $entry['status']        = 'url_mismatch';
        $entry['ok']            = false;
        $entry['activated_for'] = $normalize( $url );
    } elseif ( $state === '' ) {
        $entry['status'] = 'unknown';
        $entry['ok']     = null;
    } else {
        $entry['status'] = $state;
        $entry['ok']     = $state === 'active';
    }
    if ( is_array( $status ) && ! empty( $status['expiry'] ) && empty( $status['lifetime'] ) ) {
        $entry['expires'] = $date( $status['expiry'] );
    }
    $results[] = $entry;
}

// Perfmatters: EDD key + last status (network sites keep both as site options).
if ( isset( $slugs['perfmatters'] ) ) {
    $covered['perfmatters'] = true;
    $get    = is_multisite() ? 'get_site_option' : 'get_option';
    $key    = defined( 'PERFMATTERS_LICENSE_KEY' ) ? (string) PERFMATTERS_LICENSE_KEY : (string) $get( 'perfmatters_edd_license_key', '' );
    $state  = (string) $get( 'perfmatters_edd_license_status', '' );
    $entry  = [ 'plugin' => 'perfmatters', 'key' => $key === '' ? 'missing' : 'present' ];
    if ( $key === '' ) {
        $entry['status'] = 'missing';
        $entry['ok']     = false;
    } elseif ( $state === '' ) {
        $entry['status'] = 'unknown';
        $entry['ok']     = null;
    } else {
        $entry['status'] = $state;
        $entry['ok']     = $state === 'valid';
    }
    $results[] = $entry;
}

// Crocoblock (JetEngine and the other jet-* plugins share one license store). A key counts
// only when it is active for this address and not past its expiry.
$jet = array_values( array_filter( array_keys( $slugs ), function ( $s ) { return strpos( $s, 'jet-' ) === 0; } ) );
if ( $jet ) {
    $store = get_option( 'jet-license-data' );
    $list  = is_array( $store ) && ! empty( $store['license-list'] ) && is_array( $store['license-list'] ) ? $store['license-list'] : [];
    if ( $list || isset( $slugs['jet-engine'] ) ) {
        foreach ( $jet as $s ) {
            $covered[ $s ] = true;
        }
        $entry = [ 'plugin' => 'crocoblock', 'plugins' => $jet, 'key' => $list ? 'present' : 'missing', 'status' => 'missing', 'ok' => false ];
        foreach ( $list as $item ) {
            $details = (array) ( $item['licenseDetails'] ?? [] );
            $expire  = (string) ( $details['expire'] ?? '' );
            $lifetime = $expire === '' || in_array( $expire, [ '0000-00-00 00:00:00', '1000-01-01 00:00:00', 'lifetime' ], true );
            $site    = $normalize( $details['site_url'] ?? '' );
            if ( ( $item['licenseStatus'] ?? '' ) !== 'active' ) {
                $status = (string) ( $item['licenseStatus'] ?? 'inactive' );
            } elseif ( ! $lifetime && strtotime( $expire ) && strtotime( $expire ) < time() ) {
                $status = 'expired';
            } elseif ( $site !== '' && $site !== $home ) {
                $status = 'url_mismatch';
                $entry['activated_for'] = $site;
            } else {
                $status = 'valid';
            }
            if ( ! $lifetime ) {
                $entry['expires'] = $expire;
            }
            $entry['status'] = $status;
            $entry['ok']     = $status === 'valid';
            if ( $status === 'valid' ) {
                unset( $entry['activated_for'] );
                break;
            }
        }
        $results[] = $entry;
    }
}

// Any other active plugin whose last update check offered a new version with no download
// package: the usual sign of a premium plugin that cannot fetch its update without a license.
$updates = get_site_transient( 'update_plugins' );
if ( is_object( $updates ) && ! empty( $updates->response ) ) {
    foreach ( (array) $updates->response as $file => $item ) {
        $item = (array) $item;
        $slug = strtok( (string) $file, '/' );
        if ( ! in_array( $file, $active, true ) || isset( $covered[ $slug ] ) || ! empty( $item['package'] ) ) {
            continue;
        }
        $results[] = [
            'plugin'      => $slug,
            'status'      => 'no_package',
            'ok'          => false,
            'new_version' => (string) ( $item['new_version'] ?? '' ),
            'checked'     => $date( $updates->last_checked ?? 0 ),
        ];
    }
}

echo json_encode( $results );
}, '[]' );

