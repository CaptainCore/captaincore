#!/usr/bin/env bash

#
#   Deploys only a rotated Mailgun SMTP password
#
#   `deploy-mailgun-password --domain=<zone> --password=<password>`
#
#   Rewrites the password wherever the site authenticates as postmaster@<zone>
#   and leaves everything else (plugin, from name, connectors) alone:
#     - Gravity SMTP generic connector (gravitysmtp_generic), every blog on a multisite
#     - the official Mailgun plugin's SMTP password (mailgun option)
#     - GRAVITYSMTP_GENERIC_PASSWORD in wp-config.php, which Gravity SMTP reads before its options
#   Prints one key:value line per change and ends with result:<count>.
#

# Loop through arguments and separate regular arguments from flags
for arg in "$@"; do

  # Add to arguments array. (Does not starts with "--")
  if [[ $arg != --* ]]; then
    count=1+${#arguments[*]}
    arguments[$count]=$arg
    continue
  fi

  # Remove leading "--"
  flag_name=$( echo $arg | cut -c 3- )

  # Add to flags array
  count=1+${#flags[*]}
  flags[$count]=$arg

  # Process flags without data (Assign to variable)
  if [[ $arg != *"="* ]]; then
    flag_name=${flag_name//-/_}
    [[ $flag_name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && declare "$flag_name"=true
  fi

  # Process flags with data (Assign to variable)
  if [[ $arg == *"="* ]]; then
    flag_value=$( echo $flag_name | perl -n -e '/.+?=(.+)/&& print $1' ) # extract value
    flag_name=$( echo $flag_name | perl -n -e '/(.+?)=.+/&& print $1' ) # extract name
    flag_name=${flag_name/-/_}

    # Remove first and last quote if found
    flag_value="${flag_value%\"}"
    flag_value="${flag_value#\"}"

    [[ $flag_name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && declare "$flag_name"="$flag_value"
    continue
  fi

done

if [[ -z "$domain" || -z "$password" ]]; then
  echo "error:--domain and --password are required"
  exit 1
fi

# Handed to PHP through the environment so the password never lands in PHP source.
export MAILGUN_ZONE="$domain"
export MAILGUN_PASSWORD="$password"

read -r -d '' php_code << 'PHPEOF'
<?php
$zone     = strtolower( trim( getenv( 'MAILGUN_ZONE' ) ) );
$password = getenv( 'MAILGUN_PASSWORD' );
$login    = "postmaster@$zone";
$updated  = 0;

$blog_ids = is_multisite() ? get_sites( [ 'fields' => 'ids', 'number' => 0 ] ) : [ get_current_blog_id() ];
foreach ( $blog_ids as $blog_id ) {
	if ( is_multisite() ) {
		switch_to_blog( $blog_id );
	}
	$label = is_multisite() ? "blog $blog_id" : 'site';

	// Gravity SMTP stores the connector as a JSON string; keep whatever shape it had.
	$raw    = get_option( 'gravitysmtp_generic' );
	$config = is_string( $raw ) ? json_decode( $raw, true ) : ( is_array( $raw ) ? $raw : null );
	if ( is_array( $config ) ) {
		$username = strtolower( trim( $config['username'] ?? '' ) );
		if ( $username !== $login ) {
			echo "gravitysmtp_skipped:$label uses " . ( $username ?: 'no username' ) . "\n";
		} elseif ( ( $config['password'] ?? '' ) === $password ) {
			echo "gravitysmtp_current:$label\n";
			$updated++;
		} else {
			$config['password'] = $password;
			update_option( 'gravitysmtp_generic', is_string( $raw ) ? wp_json_encode( $config ) : $config );
			echo "gravitysmtp_updated:$label\n";
			$updated++;
		}
	}

	// Official Mailgun plugin in SMTP mode.
	$mailgun = get_option( 'mailgun' );
	if ( is_array( $mailgun ) && strtolower( trim( $mailgun['username'] ?? '' ) ) === $login ) {
		$mailgun['password'] = $password;
		update_option( 'mailgun', $mailgun );
		echo "mailgun_plugin_updated:$label\n";
		$updated++;
	}

	if ( is_multisite() ) {
		restore_current_blog();
	}
}

// The wp-config constant wins over the option, so report it for the shell to rewrite.
if ( defined( 'GRAVITYSMTP_GENERIC_PASSWORD' ) ) {
	$const_user = defined( 'GRAVITYSMTP_GENERIC_USERNAME' ) ? strtolower( trim( GRAVITYSMTP_GENERIC_USERNAME ) ) : '';
	if ( $const_user === '' || $const_user === $login ) {
		echo GRAVITYSMTP_GENERIC_PASSWORD === $password ? "constant_current:wp-config\n" : "constant_stale:wp-config\n";
	} else {
		echo "constant_skipped:wp-config uses $const_user\n";
	}
}

// Mailers that would send instead of Gravity SMTP are reported, never changed.
include_once ABSPATH . 'wp-admin/includes/plugin.php';
$other_mailers = [
	'wp-mail-smtp/wp_mail_smtp.php'     => 'WP Mail SMTP',
	'wp-mail-smtp-pro/wp_mail_smtp.php' => 'WP Mail SMTP Pro',
	'fluent-smtp/fluent-smtp.php'       => 'FluentSMTP',
	'post-smtp/postman-smtp.php'        => 'Post SMTP',
];
foreach ( $other_mailers as $file => $name ) {
	if ( is_plugin_active( $file ) ) {
		echo "other_mailer:$name is active and was not changed\n";
	}
}

echo "updated_count:$updated\n";
PHPEOF

output=$( echo "$php_code" | wp eval-file - --skip-plugins --skip-themes 2>&1 )
echo "$output" | grep -v '^updated_count:'
updated=$( echo "$output" | grep '^updated_count:' | cut -d: -f2 )
updated=${updated:-0}

if echo "$output" | grep -q '^constant_stale:'; then
  if wp config set GRAVITYSMTP_GENERIC_PASSWORD "$password" --type=constant --skip-plugins --skip-themes > /dev/null 2>&1; then
    echo "constant_updated:wp-config"
    updated=$(( updated + 1 ))
  else
    echo "error:could not rewrite GRAVITYSMTP_GENERIC_PASSWORD in wp-config.php"
  fi
elif echo "$output" | grep -q '^constant_current:'; then
  updated=$(( updated + 1 ))
fi

echo "result:$updated"
