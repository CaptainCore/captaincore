// --- Error log manifest + PHP eval()'d code tell + high-risk security_log events ---
$run_multi_probe( function () {
global $wpdb;
$files     = [];
$evals     = [];
$home_path = get_home_path();
$parent    = dirname( $home_path );
$wpc       = empty( WP_CONTENT_DIR ) ? "{$home_path}wp-content" : WP_CONTENT_DIR;
$wpc_base  = basename( $wpc );

if (! function_exists('str_ends_with')) {
    function str_ends_with(string $h, string $n): bool {
        $l = strlen($n);
        return ($l === 0 || 0 === substr_compare($h, $n, -$l));
    }
}

$norm_path = function ( $p ) use ( $home_path, $parent ) {
    $p = str_replace( '\\', '/', trim( (string) $p ) );
    $hp = rtrim( str_replace( '\\', '/', $home_path ), '/' ) . '/';
    $pp = rtrim( str_replace( '\\', '/', $parent ), '/' ) . '/';
    if ( strpos( $p, $hp ) === 0 ) {
        return substr( $p, strlen( $hp ) );
    }
    if ( strpos( $p, $pp ) === 0 ) {
        return substr( $p, strlen( $pp ) );
    }
    return ltrim( $p, '/' );
};

$scan_eval_tail = function ( $name, $path, $size ) use ( &$evals, $norm_path ) {
    $fh = @fopen( $path, 'rb' );
    if ( ! $fh ) { return; }
    $window = 262144; // last 256 KB
    if ( $size > $window ) {
        fseek( $fh, -$window, SEEK_END );
        fgets( $fh ); // discard partial leading line
    }
    while ( ( $line = fgets( $fh ) ) !== false ) {
        if ( stripos( $line, "eval()'d code" ) === false ) {
            continue;
        }
        $file = '';
        $lnum = 0;
        if ( preg_match( '/\bin\s+([^\s(]+)\((\d+)\)\s*:\s*eval\(\)\'d code/i', $line, $m ) ) {
            $file = $norm_path( $m[1] );
            $lnum = (int) $m[2];
        } elseif ( preg_match( '/\bin\s+([^\s:]+).*eval\(\)\'d code/i', $line, $m ) ) {
            $file = $norm_path( $m[1] );
        }
        if ( $file === '' ) { continue; }
        $key = $name . '|' . $file . '|' . $lnum;
        $clean = trim( preg_replace( '/[^\x20-\x7e]+/', ' ', $line ) );
        if ( strlen( $clean ) > 300 ) { $clean = substr( $clean, 0, 300 ) . '...'; }
        if ( ! isset( $evals[ $key ] ) ) {
            if ( count( $evals ) >= 20 ) { continue; }
            $evals[ $key ] = [ 'log' => $name, 'file' => $file, 'line' => $lnum, 'count' => 0, 'excerpt' => $clean ];
        }
        $evals[ $key ]['count']++;
        $evals[ $key ]['excerpt'] = $clean;
    }
    fclose( $fh );
};

$log_entry = function ( $name, $path ) {
    $size  = filesize( $path );
    $lines = 0;
    $fh = fopen( $path, 'r' );
    if ( $fh ) {
        while ( fgets( $fh ) !== false ) { $lines++; }
        fclose( $fh );
    }
    return [ "name" => $name, "size" => $size, "lines" => $lines ];
};

if ( is_file( "{$home_path}error_log" ) && filesize( "{$home_path}error_log" ) > 0 ) {
    $e = $log_entry( "error_log", "{$home_path}error_log" );
