#!/usr/bin/env bash

#
#   Runs custom bash script or WP-CLI commands on a site.
#
#   `captaincore run <site> --code=<code>`
#

while read config; do
  if [[ "$config" == "Error:"* ]]; then
    continue
  fi
  [[ ${config%%=*} =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
  declare "$config"
done <<< "$(captaincore config fetch --captain-id=$CAPTAIN_ID)"

if [ ${#@} -gt 0 ] && [[ "$CAPTAINCORE_CODE" != "" ]]; then
  # Generates receipe. Every run gets its own file: a name built from the
  # date and the first bytes of the code made two runs of similar scripts on
  # the same day share one file, so one job's sites ran the other job's code.
  timestamp=$( date +'%Y-%m-%d' )
  run_id=$( head -c 8 /dev/urandom | od -An -tx1 | tr -d ' \n' )
  if [[ ! "$run_id" =~ ^[0-9a-f]{16}$ ]]; then
    echo -e "${COLOR_RED}Error:${COLOR_NORMAL} Could not generate a run id."
    exit 1
  fi
  recipe_name=run-${timestamp}-${run_id}
  recipe_file=$path_recipes/${CAPTAIN_ID}-${recipe_name}.sh
  # Decode onto disk via PHP. Do not capture the script into a bash
  # double-quoted string — that eats backslash-newlines (breaking `|| \`
  # continuations) and expands $vars before the recipe ever reaches the site.
  ( umask 077; php -r 'echo base64_decode( (string) getenv( "CAPTAINCORE_CODE" ) );' > "${recipe_file}" )

  # Runs on specifed sites, then removes the one-off recipe
  captaincore ssh $1 --recipe=$recipe_name --captain-id=$CAPTAIN_ID
  status=$?
  rm -f "${recipe_file}"
  exit $status

fi

# Error if no sites specifed
echo -e "${COLOR_RED}Error:${COLOR_NORMAL} Please specify a <site> and --code=<code>."