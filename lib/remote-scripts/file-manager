#!/usr/bin/env bash

#
#   File manager — list directories and read files, locked to the site's
#   home directory. Backs the CaptainCore Manager "Files" tab.
#
#   Usage:
#     captaincore ssh <site> --script=file-manager --path-b64=<base64 rel path>
#     captaincore ssh <site> --script=file-manager --action=view --path-b64=... [--bytes=524288]
#     captaincore ssh <site> --script=file-manager --action=delete --path-b64=...
#
#   Flags:
#     --action=<list|view|delete>  list a directory (default), read one file,
#                                  or delete one REGULAR file (never a
#                                  directory or symlink)
#     --path-b64=<base64>    requested path RELATIVE to home, base64-encoded
#                            (base64 so spaces/quotes survive the ssh hop)
#     --bytes=<n>            view: max bytes returned (default 512 KB)
#
#   Output: the JSON document, base64-encoded and wrapped into short lines
#   between CC_FM_BEGIN / CC_FM_END markers. The dispatch server reads child
#   output with a line scanner capped at 64 KB per line, so one long JSON line
#   (a big file view, a huge directory) would wedge the whole request — short
#   wrapped lines keep every hop happy. Everything resolves through realpath,
#   so any path (including symlinks) that lands outside the home directory is
#   refused.
#

set -uo pipefail

action="list"
path_b64=""
bytes="524288"

for arg in "$@"; do
    case "$arg" in
        --action=*)   action="${arg#--action=}" ;;
        --path-b64=*) path_b64="${arg#--path-b64=}" ;;
        --bytes=*)    bytes="${arg#--bytes=}" ;;
    esac
done

export FM_ACTION="$action" FM_PATH_B64="$path_b64" FM_BYTES="$bytes"

# The script itself arrives on ssh stdin, so the PHP payload is piped from a
# variable (fetch-site-data pattern) — php must not read the ssh stream.
read -r -d '' FM_PHP <<'PHPEOF'
<?php
function fm_out( $data ) {
    echo "CC_FM_BEGIN\n";
    echo chunk_split( base64_encode( json_encode( $data ) ), 8192, "\n" );
    echo "CC_FM_END\n";
    exit( 0 );
}

$home = getcwd();
if ( $home === false ) {
    fm_out( [ "error" => "Could not resolve home directory." ] );
}
$home = rtrim( $home, "/" );

$rel = trim( (string) base64_decode( getenv( "FM_PATH_B64" ) ?: "", true ) );
$rel = ltrim( $rel, "/" );

// Delete works on the LITERAL path, not the realpath — realpath resolves a
// symlink to its target, and unlinking the target of a link is never what a
// delete click meant. Containment is checked on the parent directory instead,
// then symlinks and directories are refused outright.
if ( getenv( "FM_ACTION" ) === "delete" ) {
    if ( $rel === "" ) {
        fm_out( [ "error" => "No file specified." ] );
    }
    $parent = realpath( dirname( "$home/$rel" ) );
    if ( $parent === false || ( $parent !== $home && strpos( $parent, "$home/" ) !== 0 ) ) {
        fm_out( [ "error" => "Path is outside the home directory." ] );
    }
    $literal = $parent . "/" . basename( $rel );
    if ( is_link( $literal ) ) {
        fm_out( [ "error" => "Symlinks can't be deleted here." ] );
    }
    if ( is_dir( $literal ) ) {
        fm_out( [ "error" => "Directories can't be deleted here." ] );
    }
    if ( ! is_file( $literal ) ) {
        fm_out( [ "error" => "File not found." ] );
    }
    if ( ! @unlink( $literal ) ) {
        fm_out( [ "error" => "Could not delete the file (permissions?)." ] );
    }
    $rel_clean = substr( $literal, strlen( $home ) + 1 );
    fm_out( [ "deleted" => $rel_clean ] );
}

$target = realpath( $rel === "" ? $home : "$home/$rel" );

// The lock: realpath resolves symlinks too, so anything that lands outside
// the home directory — traversal or symlink — is refused.
if ( $target === false ) {
    fm_out( [ "error" => "Path not found." ] );
}
if ( $target !== $home && strpos( $target, "$home/" ) !== 0 ) {
    fm_out( [ "error" => "Path is outside the home directory." ] );
}

$rel_clean = $target === $home ? "" : substr( $target, strlen( $home ) + 1 );

if ( getenv( "FM_ACTION" ) === "view" ) {
    if ( ! is_file( $target ) ) {
        fm_out( [ "error" => "Not a file." ] );
    }
    if ( ! is_readable( $target ) ) {
        fm_out( [ "error" => "File is not readable." ] );
    }
    $size = filesize( $target );
    // Images preview in the browser as data URIs, so they need the WHOLE file
    // (a truncated image is a corrupt image) — read them in full, bypassing
    // FM_BYTES, up to a hard 8 MB cap. Larger files fall through to the
    // generic binary/no-preview answer. SVG rides this path too: the UI
    // renders it via <img src="data:…">, which cannot execute scripts, so a
    // hostile SVG on a managed site stays inert.
    $image_mimes = [
        "png"  => "image/png",
        "jpg"  => "image/jpeg",
        "jpeg" => "image/jpeg",
        "gif"  => "image/gif",
        "webp" => "image/webp",
        "svg"  => "image/svg+xml",
        "ico"  => "image/x-icon",
        "bmp"  => "image/bmp",
        "avif" => "image/avif",
    ];
    $ext = strtolower( pathinfo( $target, PATHINFO_EXTENSION ) );
    if ( isset( $image_mimes[ $ext ] ) && $size !== false && $size <= 8388608 ) {
        fm_out( [
            "path"        => $rel_clean,
            "size"        => $size,
            "truncated"   => false,
            "binary"      => true,
            "image"       => $image_mimes[ $ext ],
            "content_b64" => base64_encode( (string) file_get_contents( $target ) ),
        ] );
    }
    $max  = max( 1024, (int) ( getenv( "FM_BYTES" ) ?: 524288 ) );
    $content = (string) file_get_contents( $target, false, null, 0, $max );
    // Null byte or invalid UTF-8 in the head = treat as binary, no preview.
    $binary = strpos( $content, "\0" ) !== false || ! preg_match( "//u", substr( $content, 0, 8192 ) );
    fm_out( [
        "path"        => $rel_clean,
        "size"        => $size,
        "truncated"   => $size > $max,
        "binary"      => $binary,
        "content_b64" => $binary ? null : base64_encode( $content ),
    ] );
}

if ( ! is_dir( $target ) ) {
    fm_out( [ "error" => "Not a directory." ] );
}
if ( ! is_readable( $target ) ) {
    fm_out( [ "error" => "Directory is not readable." ] );
}

$entries = [];
foreach ( scandir( $target ) as $name ) {
    if ( $name === "." || $name === ".." ) {
        continue;
    }
    $p      = "$target/$name";
    $is_dir = is_dir( $p ); // follows symlinks — matches what navigation does
    $entries[] = [
        "name"  => $name,
        "type"  => $is_dir ? "dir" : "file",
        "link"  => is_link( $p ),
        "size"  => $is_dir ? null : ( is_file( $p ) ? filesize( $p ) : null ),
        "mtime" => @filemtime( $p ) ?: null,
    ];
}

fm_out( [ "path" => $rel_clean, "entries" => $entries ] );
PHPEOF

echo "$FM_PHP" | php
