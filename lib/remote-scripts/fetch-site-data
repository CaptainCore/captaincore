// Pass 1: classify ROLE definitions (catches a redefined low role carrying takeover caps).
$roles = get_option( $wpdb->prefix . 'user_roles', [] );
$all_role_slugs = array_keys( (array) $roles );
$admin_roles = []; $content_only_roles = []; $role_audit = [];
foreach ( (array) $roles as $rk => $rd ) {
    $caps = isset( $rd['capabilities'] ) ? array_keys( array_filter( (array) $rd['capabilities'] ) ) : [];
    $danger = array_values( array_intersect( $caps, array_merge( $TAKEOVER, $CONTENT ) ) );
    if ( array_intersect( $caps, $TAKEOVER ) )      { $admin_roles[] = $rk; $role_audit[$rk] = $danger; }
    elseif ( array_intersect( $caps, $CONTENT ) )   { $content_only_roles[] = $rk; $role_audit[$rk] = $danger; }
}
$admin_role_set = array_unique( array_merge( $admin_roles, [ 'administrator', 'super_admin' ] ) );

// Pass 2: targeted capabilities-meta scan for admin-capable roles OR direct takeover caps.
$tokens = array_unique( array_merge( $admin_role_set, $TAKEOVER ) );
$likes  = [];
foreach ( $tokens as $t ) { $likes[] = $wpdb->prepare( "meta_value LIKE %s", '%' . $wpdb->esc_like( $t ) . '%' ); }
$rows = $wpdb->get_results( "SELECT user_id, meta_value FROM {$wpdb->usermeta}
    WHERE meta_key = '{$wpdb->prefix}capabilities' AND (" . implode( ' OR ', $likes ) . ")" );

$cap_user_ids = []; $admin_ids = []; $injected = []; $user_role_map = [];
foreach ( $rows as $r ) {
    $caps = maybe_unserialize( $r->meta_value );
    if ( ! is_array( $caps ) ) { continue; }
    $ur = array_keys( array_filter( $caps ) );
    // Separate the user's actual ROLE slugs from individually-granted capabilities. wp_capabilities
    // stores role slugs + directly-added caps; role-INHERITED caps are resolved at runtime, not stored.
    $base_roles = array_values( array_intersect( $ur, $all_role_slugs ) );
    $extra_caps = array_values( array_diff( $ur, $all_role_slugs ) );

    $has_takeover   = (bool) array_intersect( $ur, $TAKEOVER );
    $via_admin_role = (bool) array_intersect( $base_roles, $admin_role_set );
    if ( ! $has_takeover && ! $via_admin_role ) { continue; }
    $uid = (int) $r->user_id;
    $cap_user_ids[] = $uid;
    $user_role_map[$uid] = $base_roles;

    // Effective administrator: an admin role, legacy level_10, or holds most core-admin caps —
    // regardless of how privileges are stored. These ARE admins (count in the admin tier), not backdoors.
    $is_effective_admin = $via_admin_role || in_array( 'level_10', $ur, true )
        || count( array_intersect( $ur, $CORE_ADMIN ) ) >= 4;
    if ( $is_effective_admin ) { $admin_ids[] = $uid; }

    // Injected-capability backdoor: a NON-admin account carrying an individually-granted CODE/CONFIG
    // takeover cap (manage_options, install_plugins, edit_themes/files, ...). Role-inherited caps,
    // user-management-only grants, and effective-admins are excluded — those were the false positives
    // on the first fleet run (User-Role-Editor cap-bags, "member manager" roles).
    if ( ! $is_effective_admin ) {
        $injected_code = array_values( array_intersect( $extra_caps, $CODE_TAKEOVER ) );
        if ( $injected_code ) {
            $injected[] = [ 'user_id' => $uid, 'base_roles' => $base_roles,
                'extra_caps'    => array_values( array_intersect( $extra_caps, $TAKEOVER ) ),
                'injected_caps' => $injected_code ];
        }
    }
}

// Pull identities + sessions only for the (small) privileged set.
$accounts = [];
$tier = [ 'administrator' => [ 'users' => 0, 's' => 0, 'ips' => [] ],
          'admin_capable' => [ 'users' => 0, 's' => 0, 'ips' => [] ] ];
if ( $cap_user_ids ) {
    $in   = implode( ',', array_map( 'intval', $cap_user_ids ) );
    $info = $wpdb->get_results( "SELECT ID, user_login, user_registered FROM {$wpdb->users} WHERE ID IN ($in)" );
    // Posts each privileged account touched in the last two days, for the Manager's admin
    // watch (what a new administrator did). The daily sync overlaps by a day.
    $recent = [];
    $posts  = $wpdb->get_results( $wpdb->prepare( "SELECT ID, post_author, post_type, post_status, post_title, post_modified_gmt FROM {$wpdb->posts}
        WHERE post_author IN ($in) AND post_modified_gmt >= %s AND post_type NOT IN ('revision','nav_menu_item','customize_changeset','oembed_cache')
        AND post_status <> 'auto-draft' ORDER BY post_modified_gmt DESC LIMIT 500", gmdate( 'Y-m-d H:i:s', time() - 2 * DAY_IN_SECONDS ) ) );
    foreach ( $posts as $p ) {
        $a = (int) $p->post_author;
        $recent[$a]['count'] = ( $recent[$a]['count'] ?? 0 ) + 1;
        if ( count( $recent[$a]['items'] ?? [] ) < 5 ) {
            $recent[$a]['items'][] = [ 'id' => (int) $p->ID, 'type' => $p->post_type, 'status' => $p->post_status,
                'title' => mb_substr( $p->post_title, 0, 80 ), 'modified' => $p->post_modified_gmt ];
        }
    }
    foreach ( $info as $u ) {
        $uid      = (int) $u->ID;
        $is_admin = in_array( $uid, $admin_ids, true );
        $sessions = get_user_meta( $uid, 'session_tokens', true );
        $s_out = [];
        if ( is_array( $sessions ) ) {
            foreach ( $sessions as $s ) {
                $ip = $s['ip'] ?? '';
                $s_out[] = [
                    'ip'         => $ip,
                    'login'      => isset( $s['login'] ) ? date( 'Y-m-d H:i:s', $s['login'] ) : '',
                    'expiration' => isset( $s['expiration'] ) ? date( 'Y-m-d H:i:s', $s['expiration'] ) : '',
                ];
                $tier['admin_capable']['s']++;
                if ( $ip ) { $tier['admin_capable']['ips'][ $ip ] = 1; }
                if ( $is_admin ) {
                    $tier['administrator']['s']++;
                    if ( $ip ) { $tier['administrator']['ips'][ $ip ] = 1; }
                }
            }
        }
        // Application passwords outlive a password reset; never send the hash.
        $apps = [];
        foreach ( (array) get_user_meta( $uid, '_application_passwords', true ) as $ap ) {
            if ( ! is_array( $ap ) ) { continue; }
            $apps[] = [
                'name'      => mb_substr( (string) ( $ap['name'] ?? '' ), 0, 80 ),
                'created'   => ! empty( $ap['created'] ) ? gmdate( 'Y-m-d H:i:s', (int) $ap['created'] ) : '',
                'last_used' => ! empty( $ap['last_used'] ) ? gmdate( 'Y-m-d H:i:s', (int) $ap['last_used'] ) : '',
                'last_ip'   => (string) ( $ap['last_ip'] ?? '' ),
            ];
        }
        // Newest 20 keeps the payload small on an account with many.
        usort( $apps, function ( $x, $y ) { return strcmp( $y['created'], $x['created'] ); } );
        $apps = array_slice( $apps, 0, 20 );
        $tier['admin_capable']['users']++;
        if ( $is_admin ) { $tier['administrator']['users']++; }
        $accounts[] = [
            'user_id'       => $uid,
            'login'         => $u->user_login,
            'roles'         => array_values( $user_role_map[ $uid ] ?? [] ),
            'registered'    => $u->user_registered,
            'is_admin'      => $is_admin,
            'sessions'      => $s_out,
            'app_passwords' => $apps,
            'recent_posts'  => $recent[ $uid ] ?? [ 'count' => 0 ],
        ];
    }
}

$out = [
    'collected_at'         => gmdate( 'Y-m-d\TH:i:s\Z' ),
    'total_users'          => (int) $wpdb->get_var( "SELECT COUNT(*) FROM {$wpdb->users}" ),
    'session_token_rows'   => (int) $wpdb->get_var( "SELECT COUNT(*) FROM {$wpdb->usermeta} WHERE meta_key = 'session_tokens'" ),
    'administrator'        => [ 'users' => $tier['administrator']['users'], 'active_sessions' => $tier['administrator']['s'], 'unique_ips' => count( $tier['administrator']['ips'] ) ],
    'admin_capable'        => [ 'users' => $tier['admin_capable']['users'], 'active_sessions' => $tier['admin_capable']['s'], 'unique_ips' => count( $tier['admin_capable']['ips'] ) ],
    'admin_capable_roles'  => array_values( $admin_roles ),
    'content_only_roles'   => array_values( $content_only_roles ),
    'redefined_role_audit' => (object) $role_audit,
    'super_admins'         => function_exists( 'get_super_admins' ) ? array_values( get_super_admins() ) : [],
    'injected_users'       => $injected,
    'accounts'             => $accounts,
];
echo wp_json_encode( $out );
}, '{}' );

// --- Spam signal (Breakwater fleet reputation) ---
$run_probe( 'spam_signal', function () {
// Spam signal — fleet reputation telemetry for Breakwater. Reads the last 26 hours
// of verdicts the site already made (Gravity Forms spam/active entries, spam/approved comments,
// Flamingo spam/inbox, the Breakwater log) and emits HASHES only: the sender's IP and email for
// spam, and fingerprints of the message for every verdict: an exact hash and eight MinHash bands
// that also match reworded copies. No raw IP, email or text leaves. Also reports whether
// Breakwater is active and which fleet list it holds, so sync-data knows whether to send one.
// The hash functions mirror Breakwater\Reputation (tests/reputation-parity.php).
global $wpdb;
$window = 26 * HOUR_IN_SECONDS; // Daily sync plus overlap; the Manager merges repeats.
$since  = gmdate( 'Y-m-d H:i:s', time() - $window );
$limit  = 1000;
$salt   = 'breakwater-reputation-v1|';
$home   = (string) get_option( 'home' );
$host   = strtolower( (string) preg_replace( '/^www\./', '', (string) wp_parse_url( $home, PHP_URL_HOST ) ) );
$name   = explode( '.', $host )[0] ?? '';
$table  = function ( $t ) use ( $wpdb ) { return (bool) $wpdb->get_var( $wpdb->prepare( 'SHOW TABLES LIKE %s', $wpdb->prefix . $t ) ); };

$h_ip = function ( $ip ) use ( $salt ) {
    $packed = @inet_pton( trim( (string) $ip ) );
    return false === $packed ? '' : hash( 'sha256', $salt . 'ip|' . inet_ntop( $packed ) );
};
$h_email = function ( $email ) use ( $salt ) {
    $email = strtolower( trim( (string) $email ) );
    return false !== strpos( $email, '@' ) ? hash( 'sha256', $salt . 'email|' . $email ) : '';
};
$normalize = function ( $text ) use ( $name ) {
    $text = (string) preg_replace( '/<[^>]*>/', ' ', (string) $text );
    $text = strtolower( $text );
    $text = (string) preg_replace( '#https?://\S+|www\.\S+|\d+#', ' ', $text );
    if ( strlen( $name ) >= 3 ) {
        $text = str_replace( $name, ' ', $text );
    }
    return trim( (string) preg_replace( '/[^\p{L}\p{N}]+/u', ' ', $text ) );
};
// The message's exact hash ('m') and its MinHash bands ('b': 8 bands x 4 rows, 3-word shingles).
$h_message = function ( $text ) use ( $salt, $normalize ) {
    $text  = $normalize( $text );
    $len   = function_exists( 'mb_strlen' ) ? mb_strlen( $text ) : strlen( $text );
    $out   = [ 'm' => $len >= 40 ? hash( 'sha256', $salt . 'message|' . $text ) : '', 'b' => [] ];
    $words = array_slice( preg_split( '/\s+/', $text, -1, PREG_SPLIT_NO_EMPTY ) ?: [], 0, 400 );
    if ( count( $words ) < 8 ) {
        return $out;
    }
    $shingles = [];
    for ( $i = 0; $i <= count( $words ) - 3; $i++ ) {
        $shingles[ implode( ' ', array_slice( $words, $i, 3 ) ) ] = true;
    }
    $shingles = array_keys( $shingles );
    for ( $b = 0; $b < 8; $b++ ) {
        $mins = [];
        for ( $r = 0; $r < 4; $r++ ) {
            $seed = $b * 4 + $r;
            $min  = PHP_INT_MAX;
            foreach ( $shingles as $shingle ) {
                $min = min( $min, crc32( $seed . '|' . $shingle ) );
            }
            $mins[] = $min;
        }
        $out['b'][] = hash( 'sha256', $salt . 'mband|' . $b . '|' . implode( ',', $mins ) );
    }
    return $out;
};

$items = [];
$add   = function ( $kind, $hash, $verdict, $source, $labeller, $at ) use ( &$items ) {
    if ( '' === $hash ) {
        return;
    }
    $key = $kind . $hash . $verdict;
    if ( ! isset( $items[ $key ] ) ) {
        $items[ $key ] = [ 'k' => $kind, 'h' => $hash, 'v' => $verdict, 's' => $source, 'l' => $labeller, 'n' => 0, 'f' => $at, 't' => $at ];
    }
    $items[ $key ]['n']++;
    $items[ $key ]['f'] = min( $items[ $key ]['f'], $at );
    $items[ $key ]['t'] = max( $items[ $key ]['t'], $at );
};
// IP and email reputation comes from spam only; messages from every verdict, since the same
// pitch reaching many sites is the signal whether or not each site caught it. A site owner's
// "Not spam" (labeller feedback) reports the sender too, so the fleet list can drop them.
$record = function ( $verdict, $source, $labeller, $at, $ip, $email, $message ) use ( $add, $h_ip, $h_email ) {
    if ( 'spam' === $verdict || 'feedback' === $labeller ) {
        $add( 'ip', $h_ip( $ip ), $verdict, $source, $labeller, $at );
        $add( 'email', $h_email( $email ), $verdict, $source, $labeller, $at );
    }
    $add( 'message', $message['m'], $verdict, $source, $labeller, $at );
    foreach ( $message['b'] as $band ) {
        $add( 'mband', $band, $verdict, $source, $labeller, $at );
    }
};
$counts = [];

// Gravity Forms: spam and active entries, who flagged spam read from the entry notes.
if ( $table( 'gf_entry' ) ) {
    $p     = $wpdb->prefix;
    $types = [];
    foreach ( $wpdb->get_results( "SELECT form_id, display_meta FROM {$p}gf_form_meta" ) as $fm ) {
        foreach ( (array) ( json_decode( (string) $fm->display_meta, true )['fields'] ?? [] ) as $f ) {
            $types[ (int) $fm->form_id ][ (string) ( $f['id'] ?? '' ) ] = (string) ( $f['type'] ?? '' );
        }
    }
    $skip = [ 'consent', 'hidden', 'html', 'section', 'page', 'captcha', 'password', 'creditcard', 'fileupload', 'signature', 'checkbox', 'radio', 'select', 'multiselect', 'product', 'total' ];
    $rows = $wpdb->get_results( $wpdb->prepare( "SELECT id, form_id, ip, status, date_created FROM {$p}gf_entry WHERE status IN ('spam','active') AND date_created > %s AND ( created_by IS NULL OR created_by = 0 ) ORDER BY id DESC LIMIT %d", $since, $limit ) );
    foreach ( $rows as $r ) {
        $email   = '';
        $longest = '';
        $textarea = '';
        foreach ( $wpdb->get_results( $wpdb->prepare( "SELECT meta_key, meta_value FROM {$p}gf_entry_meta WHERE entry_id = %d", $r->id ) ) as $m ) {
            if ( ! preg_match( '/^(\d+)(\.\d+)?$/', $m->meta_key, $mm ) ) {
                continue;
            }
            $type = $types[ (int) $r->form_id ][ $mm[1] ] ?? '';
            if ( 'email' === $type ) {
                $email = '' === $email ? (string) $m->meta_value : $email;
            } elseif ( 'textarea' === $type && strlen( (string) $m->meta_value ) > strlen( $textarea ) ) {
                $textarea = (string) $m->meta_value;
            } elseif ( ! in_array( $type, $skip, true ) && strlen( (string) $m->meta_value ) > strlen( $longest ) ) {
                $longest = (string) $m->meta_value;
            }
        }
        $labeller = 'site';
        if ( 'spam' === $r->status ) {
            $notes    = strtolower( implode( ' ', $wpdb->get_col( $wpdb->prepare( "SELECT CONCAT(user_name, ' ', value) FROM {$p}gf_entry_notes WHERE entry_id = %d", $r->id ) ) ) );
            $labeller = false !== strpos( $notes, 'breakwater' ) ? 'breakwater' : ( false !== strpos( $notes, 'cleantalk' ) ? 'cleantalk' : ( false !== strpos( $notes, 'honeypot' ) ? 'gf_honeypot' : ( false !== strpos( $notes, 'akismet' ) ? 'akismet' : ( false !== strpos( $notes, 'captcha' ) ? 'captcha' : 'site' ) ) ) );
        }
        $verdict = 'spam' === $r->status ? 'spam' : 'ham';
        $record( $verdict, 'gf', $labeller, (string) $r->date_created, (string) $r->ip, $email, $h_message( '' !== $textarea ? $textarea : $longest ) );
        $counts[ 'gf_' . $verdict ] = ( $counts[ 'gf_' . $verdict ] ?? 0 ) + 1;
    }
}

// Comments from visitors: spam and approved.
$rows = $wpdb->get_results( $wpdb->prepare( "SELECT comment_ID, comment_author_email, comment_author_IP, comment_content, comment_approved, comment_date_gmt FROM {$wpdb->comments} WHERE comment_approved IN ('spam','1') AND comment_type IN ('','comment') AND user_id = 0 AND comment_date_gmt > %s ORDER BY comment_ID DESC LIMIT %d", $since, $limit ) );
foreach ( $rows as $r ) {
    $verdict  = 'spam' === $r->comment_approved ? 'spam' : 'ham';
    $labeller = 'site';
    if ( 'spam' === $verdict ) {
        $labeller = get_comment_meta( $r->comment_ID, 'akismet_result', true ) ? 'akismet' : ( get_comment_meta( $r->comment_ID, 'ct_hash', true ) ? 'cleantalk' : 'site' );
    }
    $record( $verdict, 'comment', $labeller, (string) $r->comment_date_gmt, (string) $r->comment_author_IP, (string) $r->comment_author_email, $h_message( $r->comment_content ) );
    $counts[ 'comment_' . $verdict ] = ( $counts[ 'comment_' . $verdict ] ?? 0 ) + 1;
}

// Flamingo (Contact Form 7's inbox): spam and inbox messages.
$rows = $wpdb->get_results( $wpdb->prepare( "SELECT ID, post_status, post_content, post_date_gmt FROM {$wpdb->posts} WHERE post_type = 'flamingo_inbound' AND post_status IN ('flamingo-spam','publish') AND post_date_gmt > %s ORDER BY ID DESC LIMIT %d", $since, $limit ) );
foreach ( $rows as $r ) {
    $meta    = get_post_meta( $r->ID, '_meta', true );
    $verdict = 'flamingo-spam' === $r->post_status ? 'spam' : 'ham';
    $record( $verdict, 'flamingo', 'spam' === $verdict ? 'cf7' : 'site', (string) $r->post_date_gmt, is_array( $meta ) ? (string) ( $meta['remote_ip'] ?? '' ) : '', (string) get_post_meta( $r->ID, '_from_email', true ), $h_message( $r->post_content ) );
    $counts[ 'flamingo_' . $verdict ] = ( $counts[ 'flamingo_' . $verdict ] ?? 0 ) + 1;
}

// Breakwater's own log, which already holds the message's fingerprint and bands.
if ( $table( 'breakwater_log' ) ) {
    $t   = $wpdb->prefix . 'breakwater_log';
    $cols = $wpdb->get_col( "SHOW COLUMNS FROM {$t}" );
    $fp   = in_array( 'fingerprint', $cols, true ) ? 'fingerprint' : "''";
    $bd   = in_array( 'bands', $cols, true ) ? 'bands' : "''";
    // A message the owner marked days after it arrived (a Report link in a notification email) is reported when marked.
    $fb   = in_array( 'feedback_at', $cols, true ) ? $wpdb->prepare( ' OR feedback_at > %s', $since ) : '';
    $rows = $wpdb->get_results( $wpdb->prepare( "SELECT verdict, feedback, ip, email, {$fp} AS fingerprint, {$bd} AS bands, created_at FROM {$t} WHERE created_at > %s{$fb} ORDER BY id DESC LIMIT %d", $since, $limit ) );
    foreach ( $rows as $r ) {
        // The owner's word wins: "Not spam" is a correction, "Was spam" confirms a missed one.
        $verdict  = 'not_spam' === $r->feedback ? 'ham' : ( 'spam' === $r->verdict || 'spam' === $r->feedback ? 'spam' : 'ham' );
        $labeller = '' !== (string) $r->feedback ? 'feedback' : 'breakwater';
        $record( $verdict, 'breakwater', $labeller, (string) $r->created_at, (string) $r->ip, (string) $r->email, [ 'm' => (string) $r->fingerprint, 'b' => array_filter( explode( ',', (string) $r->bands ) ) ] );
        $counts[ 'breakwater_' . $verdict ] = ( $counts[ 'breakwater_' . $verdict ] ?? 0 ) + 1;
    }
}

// Is Breakwater on this site (as a plugin or an mu-plugin), and which fleet list does it hold?
$active_plugins = array_merge( (array) get_option( 'active_plugins', [] ), array_keys( (array) get_site_option( 'active_sitewide_plugins', [] ) ) );
$bw_active      = (bool) preg_grep( '#(^|/)breakwater\.php$#', $active_plugins ) || file_exists( WPMU_PLUGIN_DIR . '/breakwater/breakwater.php' ) || file_exists( WPMU_PLUGIN_DIR . '/breakwater.php' );
$bw_list        = get_option( 'breakwater_reputation' );

echo wp_json_encode( [
    'v'            => 2,
    'breakwater'   => [ 'active' => $bw_active, 'list' => is_array( $bw_list ) ? (string) ( $bw_list['generated'] ?? '' ) : '' ],
    'collected_at' => gmdate( 'c' ),
    'window_hours' => 26,
    'counts'       => (object) $counts,
    'items'        => array_values( $items ),
] );
}, '{}' );

// --- Network shape (multisite / WP Freighter / WP Landing Kit) ---
$run_multi_probe( function () {
global $wpdb;
$cap = 500;

// Multisite: one row per subsite, read straight from the blogs table plus
// each blog's blogname, so no switch_to_blog and no plugin code.
// Administrators of one prefix (a subsite's or a tenant's), capped: the
// Manager picks from these when it signs someone into that site, since a
// main-site admin may not be a member there.
$admins_of = function ( $users_table, $usermeta_table, $cap_key ) use ( $wpdb ) {
    $rows = $wpdb->get_results( $wpdb->prepare(
        "SELECT u.user_login, u.user_email FROM `{$users_table}` u JOIN `{$usermeta_table}` m ON m.user_id = u.ID
         WHERE m.meta_key = %s AND m.meta_value LIKE %s ORDER BY u.ID LIMIT 10",
        $cap_key, '%"administrator"%'
    ) );
    return array_map( function ( $r ) { return [ 'login' => $r->user_login, 'email' => $r->user_email ]; }, (array) $rows );
};

$network_sites = null;
if ( is_multisite() ) {
    // Scheme from the main site's stored home: network_home_url() follows
    // is_ssl(), which is always false under WP-CLI and would say http.
    $scheme = parse_url( (string) get_option( 'home' ), PHP_URL_SCHEME ) ?: 'https';
    $main   = (int) get_main_site_id();
    $total  = (int) get_sites( [ 'count' => true, 'number' => 0 ] );
    $rows   = get_sites( [ 'number' => $cap, 'orderby' => 'id', 'order' => 'ASC' ] );
    $sites  = [];
    // WordPress MU Domain Mapping: extra domains per subsite in its own table
    // (active = the one the subsite redirects to).
    $mapped_of = [];
    $dm_table  = $wpdb->base_prefix . 'domain_mapping';
    if ( $wpdb->get_var( $wpdb->prepare( 'SHOW TABLES LIKE %s', $dm_table ) ) === $dm_table ) {
        foreach ( (array) $wpdb->get_results( "SELECT blog_id, domain, active FROM `{$dm_table}` ORDER BY blog_id, active DESC, domain LIMIT 2000" ) as $d ) {
            $mapped_of[ (int) $d->blog_id ][] = [ 'domain' => strtolower( (string) $d->domain ), 'primary' => (int) $d->active === 1 ];
        }
    }
    foreach ( $rows as $b ) {
        $id   = (int) $b->blog_id;
        $name = $wpdb->get_var( "SELECT option_value FROM `{$wpdb->get_blog_prefix( $id )}options` WHERE option_name = 'blogname' LIMIT 1" );
        $sites[] = [
            'id'           => $id,
            'name'         => html_entity_decode( (string) $name, ENT_QUOTES, 'UTF-8' ),
            'url'          => $scheme . '://' . $b->domain . $b->path,
            'main'         => $id === $main,
            'registered'   => $b->registered,
            'last_updated' => $b->last_updated,
            'public'       => (int) $b->public,
