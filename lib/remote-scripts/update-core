#!/usr/bin/env bash

#
#   Sideload a WordPress core build, boot the live site against it (same
#   wp-config, database, and wp-content), probe for PHP fatals, then optionally
#   apply the update. Failed probes abort before any live core files change.
#
#   HTTP probes use the host's on-server loopback (Kinsta and Rocket.net):
#     curl -ksS -H "Host: <site>" https://localhost/
#   Sideloaded core lives in /tmp so PHP-FPM can include it. Kinsta FPM
#   open_basedir allows /tmp and the public web root, not $HOME/tmp or
#   $HOME/private. CLI PHP has no open_basedir, so a $HOME/tmp preview
#   boots under WP-CLI and then 500s over HTTP.
#
#   `update-core`
#
#   [--version=<latest|nightly|next|x.y.z>]
#   Core build to sideload and (optionally) apply. Default: latest.
#   next = RC if wordpress.org publishes one ahead of current stable,
#   else beta, else nightly.
#
#   [--probe-only]
#   Sideload and probe, but do not update live core files.
#
#   [--apply]
#   Apply the update after a clean probe. Pre-release targets (nightly /
#   *-alpha* / *-beta* / *-RC*) require this flag; latest stable applies
#   automatically after a clean probe.
#
#   [--keep]
#   Leave the sideloaded preview directory in place after the run.
#

COLOR_RED="\033[31m"
COLOR_NORMAL="\033[39m"

for arg in "$@"; do
  if [[ $arg != --* ]]; then
    count=1+${#arguments[*]}
    arguments[$count]=$arg
    continue
  fi

  flag_name=$( echo $arg | cut -c 3- )

  if [[ $arg != *"="* ]]; then
    flag_name=${flag_name//-/_}
    declare "$flag_name"=true
  fi

  if [[ $arg == *"="* ]]; then
    flag_value=$( echo $flag_name | perl -n -e '/.+?=(.+)/&& print $1' )
    flag_name=$( echo $flag_name | perl -n -e '/(.+?)=.+/&& print $1' )
    flag_name=${flag_name/-/_}
    flag_value="${flag_value%\"}"
    flag_value="${flag_value#\"}"
    declare "$flag_name"="$flag_value"
    continue
  fi
done

LIVE="$(pwd)"
SITE_USER="${USER:-$(id -un 2>/dev/null)}"
SITE_USER="${SITE_USER//[^A-Za-z0-9._-]/}"
[[ -n "$SITE_USER" ]] || SITE_USER="u$(id -u)"
PREVIEW_NAME="captaincore-core-preview-${SITE_USER}"
PREVIEW="/tmp/${PREVIEW_NAME}"
PREVIOUS="${HOME}/tmp/captaincore-core-previous"
BODY_FILE="${HOME}/tmp/cc-core-preview-body"
BOOT_FILE=""
BOOT_TOKEN=""
version="${version:-latest}"

RESULT_STATUS=""
RESULT_ACTION=""
RESULT_STAGE=""
RESULT_REASON=""
RESULT_FROM=""
RESULT_TO=""
RESULT_URL=""
RESULT_EMITTED=""

emit_result() {
  [[ -n "$RESULT_EMITTED" ]] && return
  RESULT_EMITTED=1
  local status="${RESULT_STATUS:-ok}"
  printf "result=%s" "$status"
  [[ -n "$RESULT_ACTION" ]] && printf " action=%s" "$RESULT_ACTION"
  [[ -n "$RESULT_STAGE" ]] && printf " stage=%s" "$RESULT_STAGE"
  [[ -n "$RESULT_FROM" ]] && printf " from=%s" "$RESULT_FROM"
  [[ -n "$RESULT_TO" ]] && printf " to=%s" "$RESULT_TO"
  [[ -n "$RESULT_URL" ]] && printf " url=%s" "$RESULT_URL"
  if [[ -n "$RESULT_REASON" ]]; then
    printf " reason=%s" "$(printf '%s' "$RESULT_REASON" | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g')"
  fi
  printf "\n"
}

fail_run() {
  RESULT_STATUS="fail"
  RESULT_STAGE="$1"
  shift
  RESULT_REASON="$*"
  echo -e "${COLOR_RED}Error:${COLOR_NORMAL} $*" >&2
  exit 1
}

die() {
  if [[ -z "$RESULT_STATUS" ]]; then
    RESULT_STATUS="fail"
    RESULT_STAGE="safety"
    RESULT_REASON="$*"
  fi
  echo -e "${COLOR_RED}Error:${COLOR_NORMAL} $*" >&2
  exit 1
}

is_prerelease() {
  local v="$1"
  [[ "$v" == "nightly" || "$v" == *alpha* || "$v" == *beta* || "$v" == *RC* || "$v" == *rc* ]]
}

http_ok() {
  [[ "$1" == "200" || "$1" == "301" || "$1" == "302" ]]
}

wp_core_offers_json() {
  local channel="$1"
  local url="https://api.wordpress.org/core/version-check/1.7/"
  [[ -n "$channel" ]] && url="${url}?channel=${channel}"
  curl -fsS --max-time 20 -A "CaptainCore-update-core" "$url"
}

first_offer_version() {
  local json="$1"
  local helper="${HOME}/tmp/cc-first-offer.php"
  mkdir -p "${HOME}/tmp"
  cat > "$helper" << 'PHP'
<?php
$d = json_decode( stream_get_contents( STDIN ), true );
if ( ! is_array( $d ) || empty( $d['offers'][0]['version'] ) ) {
	exit( 1 );
}
echo $d['offers'][0]['version'];
PHP
  printf '%s' "$json" | php "$helper"
  local rc=$?
  rm -f "$helper"
  return $rc
}

# RC if published ahead of stable, else beta, else nightly.
# Sets $version to a wp core download token (7.2-RC1, nightly, …).
resolve_next_core_version() {
  local json offered stable channel
  json="$( wp_core_offers_json "" )" || fail_run version "Could not fetch WordPress stable channel."
  stable="$( first_offer_version "$json" )" || fail_run version "Could not parse WordPress stable version."
  echo "stable_latest=${stable}"

  for channel in rc beta; do
    json="$( wp_core_offers_json "$channel" )" || continue
    offered="$( first_offer_version "$json" )" || continue
    if [[ -n "$offered" && "$offered" != "$stable" ]] && is_prerelease "$offered"; then
      version="$offered"
      echo "next_channel=${channel}"
      echo "next_offered=${offered}"
      return 0
    fi
  done

  json="$( wp_core_offers_json "development" )" || true
  offered="$( first_offer_version "$json" 2>/dev/null || true )"
  if [[ -n "$offered" && "$offered" != "$stable" ]] && is_prerelease "$offered"; then
    echo "next_channel=development"
    echo "next_offered=${offered}"
    version="nightly"
    return 0
  fi

  echo "next_channel=nightly"
  echo "next_offered=nightly"
  version="nightly"
}

# Last non-empty WP-CLI stdout line. Staging mu-plugins and PHP notices
# often print blank lines before the real value; those break $table_prefix.
wp_stdout() {
  wp "$@" --skip-plugins --skip-themes 2>/dev/null | tr -d '\r' | awk 'NF { line=$0 } END { printf "%s", line }'
}

# Refuse empty/root paths. Preview lives in /tmp (FPM-readable). Backup
# of live core stays under $HOME/tmp (CLI-only).
is_our_tmp_dir() {
  local path="$1"
  local expected_name="$2"
  [[ -n "$path" && -n "$expected_name" ]] || return 1
  [[ "$path" != *..* ]] || return 1
  [[ "$expected_name" == captaincore-core-* ]] || return 1
  if [[ "$path" == "/tmp/${expected_name}" ]]; then
    [[ "$path" != "/" && "$path" != "/tmp" ]] || return 1
    return 0
  fi
  [[ -n "$HOME" && "$HOME" != "/" ]] || return 1
  [[ "$path" == "${HOME}/tmp/${expected_name}" ]] || return 1
  [[ "$path" != "/" && "$path" != "$HOME" && "$path" != "$LIVE" ]] || return 1
}

is_wordpress_root() {
  local dir="$1"
  [[ -n "$dir" && "$dir" != "/" && "$dir" == /* ]] || return 1
  [[ -f "${dir}/wp-config.php" && -d "${dir}/wp-admin" && -d "${dir}/wp-includes" && -d "${dir}/wp-content" ]]
}

# rm -rf only for the two tmp dirs this script creates.
safe_rm_tree() {
  local path="$1"
  local expected_name="$2"
  if ! is_our_tmp_dir "$path" "$expected_name"; then
    die "Refusing to remove unexpected path: ${path:-<empty>}"
  fi
  if [[ -e "$path" || -L "$path" ]]; then
    if [[ -L "$path" || ! -d "$path" ]]; then
      die "Refusing to remove non-directory: $path"
    fi
    rm -rf -- "$path"
  fi
}

safe_rm_file() {
  local path="$1"
  local expected_name="$2"
  [[ -n "$path" && -n "$expected_name" ]] || return 0
  [[ "$(basename "$path")" == "$expected_name" ]] || die "Refusing to remove unexpected file: $path"
  if [[ -e "$path" || -L "$path" ]]; then
    if [[ -L "$path" || ! -f "$path" ]]; then
      die "Refusing to remove non-file: $path"
    fi
    rm -f -- "$path"
  fi
}

safe_rm_boot_file() {
  local dir="$1"
  local name="$2"
  [[ -n "$dir" && -n "$name" ]] || return 0
  [[ "$name" =~ ^core-preview-boot-[0-9a-f]+\.php$ ]] || die "Refusing to remove unexpected boot file: $name"
  is_wordpress_root "$dir" || die "Refusing to remove boot file outside a WordPress root: $dir"
  local path="${dir}/${name}"
  if [[ -e "$path" || -L "$path" ]]; then
    if [[ -L "$path" || ! -f "$path" ]]; then
      die "Refusing to remove non-file boot path: $path"
    fi
    if ! grep -q 'X-Core-Preview-Boot' "$path"; then
      die "Boot file missing preview marker, not removing: $path"
    fi
    rm -f -- "$path"
  fi
}

cleanup() {
  emit_result
  safe_rm_boot_file "$LIVE" "$BOOT_FILE"
  if [[ "$keep" != "true" ]]; then
    safe_rm_tree "$PREVIEW" "$PREVIEW_NAME"
    safe_rm_tree "$PREVIOUS" "captaincore-core-previous"
  fi
  safe_rm_file "$BODY_FILE" "cc-core-preview-body"
}
trap cleanup EXIT

http_loopback() {
  local url_path="$1"
  local extra=()
  shift || true
  while [[ $# -gt 0 ]]; do
    extra+=("$1")
    shift
  done
  curl -ksS --max-time 60 -o "$BODY_FILE" -w "%{http_code}" \
    -H "Host: ${SITE_HOST}" \
    -H "Cache-Control: no-cache" \
    "${extra[@]}" \
    "https://localhost${url_path}"
}

write_preview_config() {
  local live_config preview_config
  live_config="${LIVE}/wp-config.php"
  preview_config="${PREVIEW}/wp-config.php"

  local writer="${PREVIEW}/write-preview-config.php"
  cat > "$writer" << 'PHP'
<?php
$live_config    = $argv[1];
$preview_config = $argv[2];
$content_dir    = $argv[3];
$content_url    = $argv[4];
$table_prefix   = $argv[5];
$src            = file_get_contents( $live_config );
if ( $src === false ) {
	fwrite( STDERR, "Unable to read live wp-config.php\n" );
	exit( 1 );
}
// Strip every common wp-settings require so the preview core loads once.
$src = preg_replace(
	'/require(?:_once)?\s*\(?\s*(?:ABSPATH\s*\.\s*[\'"]wp-settings\.php[\'"]|dirname\s*\(\s*__FILE__\s*\)\s*\.\s*[\'"]\/wp-settings\.php[\'"]|__DIR__\s*\.\s*[\'"]\/wp-settings\.php[\'"])\s*\)?\s*;/',
	'/* settings deferred by captaincore update-core */',
	$src
);
// Freighter's bootstrap uses dirname(__FILE__) and ABSPATH-relative content dirs.
// Those resolve inside the preview copy and either miss the bootstrap or point
// content at preview/content/{id}. Skip it; prefix + content are injected below.
$src = preg_replace(
	'/^.*freighter\.php.*$/m',
	'/* freighter bootstrap skipped by update-core */',
	$src
);
if ( $table_prefix !== '' ) {
	$replaced = preg_replace(
		'/\$table_prefix\s*=\s*[\'"].*?[\'"]\s*;/',
		'$table_prefix = ' . var_export( $table_prefix, true ) . ';',
		$src,
		1,
		$count
	);
	if ( $count ) {
		$src = $replaced;
	}
}
// Preview must actually boot the new core, not serve a cached HTML page.
$src = preg_replace(
	'/^[ \t]*define\(\s*[\'"]WP_CACHE[\'"].+$/m',
	'/* WP_CACHE stripped for core preview */',
	$src
);
if ( file_put_contents( $preview_config . '.live.php', $src ) === false ) {
	fwrite( STDERR, "Unable to write preview wp-config.php.live.php\n" );
	exit( 1 );
}
$body  = "<?php\n";
$body .= "define( 'WP_CONTENT_DIR', " . var_export( $content_dir, true ) . " );\n";
$body .= "define( 'WP_CONTENT_URL', " . var_export( $content_url, true ) . " );\n";
$body .= "define( 'WP_CACHE', false );\n";
$body .= "define( 'DONOTCACHEPAGE', true );\n";
$body .= "define( 'CORE_PREVIEW', true );\n";
$body .= "require __DIR__ . '/wp-config.php.live.php';\n";
$body .= "require_once ABSPATH . 'wp-settings.php';\n";
if ( file_put_contents( $preview_config, $body ) === false ) {
	fwrite( STDERR, "Unable to write preview wp-config.php\n" );
	exit( 1 );
}
PHP
  if ! php "$writer" "$live_config" "$preview_config" "$LIVE_CONTENT_DIR" "$LIVE_CONTENT_URL" "$LIVE_PREFIX"; then
    safe_rm_file "$writer" "write-preview-config.php"
    fail_run config "Failed to write preview wp-config.php"
  fi
  safe_rm_file "$writer" "write-preview-config.php"
  chmod 644 "$preview_config" "${preview_config}.live.php"
}

write_probe_php() {
  cat > "${PREVIEW}/probe-render.php" << 'PHP'
<?php
$path = $args[0] ?? '/';
register_shutdown_function( function () {
	$e = error_get_last();
	if ( $e && in_array( $e['type'], array( E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR, E_USER_ERROR, E_RECOVERABLE_ERROR ), true ) ) {
		fwrite( STDERR, "FATAL: {$e['message']} in {$e['file']}:{$e['line']}\n" );
	}
} );
$host = wp_parse_url( home_url(), PHP_URL_HOST );
$_SERVER['REQUEST_METHOD']  = 'GET';
$_SERVER['HTTP_HOST']       = $host;
$_SERVER['SERVER_NAME']     = $host;
$_SERVER['REQUEST_URI']     = $path;
$_SERVER['QUERY_STRING']    = '';
$_SERVER['SERVER_PROTOCOL'] = 'HTTP/1.1';
$_GET  = array();
$_POST = array();
remove_action( 'template_redirect', 'redirect_canonical' );
add_filter( 'redirect_canonical', '__return_false', 99 );
if ( ! defined( 'WP_USE_THEMES' ) ) {
	define( 'WP_USE_THEMES', true );
}
global $wp;
ob_start();
try {
	$wp->main( '' );
	require ABSPATH . WPINC . '/template-loader.php';
} catch ( Throwable $t ) {
	ob_end_clean();
	fwrite( STDERR, 'THROW: ' . $t->getMessage() . ' in ' . $t->getFile() . ':' . $t->getLine() . "\n" );
	exit( 2 );
}
$html  = ob_get_clean();
$title = '';
if ( preg_match( '/<title>(.*?)<\/title>/is', $html, $m ) ) {
	$title = preg_replace( '/\s+/', ' ', trim( wp_strip_all_tags( $m[1] ) ) );
}
$fatal = preg_match( '/(Fatal error|Parse error|Uncaught )/i', $html ) ? 1 : 0;
printf(
	"path=%s bytes=%d is_404=%s title=%s fatal_in_html=%d wp_version=%s\n",
	$path,
	strlen( $html ),
	is_404() ? '1' : '0',
	$title,
	$fatal,
	$GLOBALS['wp_version']
);
if ( $fatal ) {
	exit( 2 );
}
PHP
}

write_http_bootstrap() {
  BOOT_TOKEN="$(php -r 'echo bin2hex(random_bytes(16));')"
  BOOT_FILE="core-preview-boot-$(php -r 'echo bin2hex(random_bytes(4));').php"
  cat > "${LIVE}/${BOOT_FILE}" << PHP
<?php
\$expected = '${BOOT_TOKEN}';
\$given    = isset( \$_SERVER['HTTP_X_CORE_PREVIEW'] ) ? \$_SERVER['HTTP_X_CORE_PREVIEW'] : '';
if ( ! is_string( \$given ) || \$given === '' || ! hash_equals( \$expected, \$given ) ) {
	header( 'HTTP/1.1 404 Not Found' );
	echo 'not found';
	exit;
}
\$path = isset( \$_GET['path'] ) ? \$_GET['path'] : '/';
if ( ! is_string( \$path ) || \$path === '' || \$path[0] !== '/' ) {
	\$path = '/';
}
\$_SERVER['REQUEST_URI'] = \$path;
\$_SERVER['SCRIPT_NAME'] = '/index.php';
\$_SERVER['PHP_SELF']    = '/index.php';
\$_GET = array();
include '${PREVIEW}/wp-includes/version.php';
header( 'X-Robots-Tag: noindex, nofollow' );
header( 'Cache-Control: private, no-store, no-cache, must-revalidate' );
header( 'X-Core-Preview-Boot: 1' );
header( 'X-Core-Preview-Version: ' . \$wp_version );
define( 'WP_USE_THEMES', true );
require '${PREVIEW}/wp-blog-header.php';
PHP
  chmod 644 "${LIVE}/${BOOT_FILE}"
}

backup_live_core() {
  is_wordpress_root "$LIVE" || die "Cannot backup core; ${LIVE} is not a WordPress root."
  safe_rm_tree "$PREVIOUS" "captaincore-core-previous"
  mkdir -p "$PREVIOUS"
  cp -a "${LIVE}/wp-admin" "${LIVE}/wp-includes" "$PREVIOUS/"
  shopt -s nullglob
  for f in "${LIVE}/wp-"*.php "${LIVE}/index.php" "${LIVE}/xmlrpc.php"; do
    [[ "$(basename "$f")" == "wp-config.php" ]] && continue
    cp -a "$f" "$PREVIOUS/"
  done
  shopt -u nullglob
  if [[ ! -f "${PREVIOUS}/wp-includes/version.php" || ! -d "${PREVIOUS}/wp-admin" ]]; then
    die "Core backup at ${PREVIOUS} is incomplete."
  fi
}

# Move live core dirs aside, copy the backup in, then delete the aside copy.
# If the copy fails, move the original back so we never rm live core first.
restore_live_core() {
  echo "Restoring previous core files..."
  is_wordpress_root "$LIVE" || die "Cannot restore core; ${LIVE} is not a WordPress root."
  is_our_tmp_dir "$PREVIOUS" "captaincore-core-previous" || die "Refusing restore from unexpected path: ${PREVIOUS:-<empty>}"
  if [[ ! -f "${PREVIOUS}/wp-includes/version.php" || ! -d "${PREVIOUS}/wp-admin" || ! -d "${PREVIOUS}/wp-includes" ]]; then
    die "Previous core backup is incomplete; refusing restore."
  fi

  local stamp old name
  stamp="cc-restore-$$"
  for name in wp-admin wp-includes; do
    [[ "$name" == "wp-admin" || "$name" == "wp-includes" ]] || die "Refusing restore of unexpected directory: $name"
    [[ -d "${LIVE}/${name}" && ! -L "${LIVE}/${name}" ]] || die "Live ${name} is not a directory."
    [[ -d "${PREVIOUS}/${name}" && ! -L "${PREVIOUS}/${name}" ]] || die "Backup ${name} is not a directory."
    old="${LIVE}/${name}.${stamp}"
    [[ ! -e "$old" ]] || die "Stale restore directory exists: $old"
    mv -- "${LIVE}/${name}" "$old" || die "Failed to move live ${name} aside."
    if ! cp -a -- "${PREVIOUS}/${name}" "${LIVE}/${name}"; then
      if [[ -e "${LIVE}/${name}" && ( "${LIVE}/${name}" == "${LIVE}/wp-admin" || "${LIVE}/${name}" == "${LIVE}/wp-includes" ) ]]; then
        rm -rf -- "${LIVE}/${name}"
      fi
      mv -- "$old" "${LIVE}/${name}"
      die "Failed to restore ${name}; original moved back."
    fi
    [[ -d "$old" && ! -L "$old" && "$old" == "${LIVE}/${name}.${stamp}" ]] || die "Refusing to remove unexpected aside path: $old"
    rm -rf -- "$old"
  done

  shopt -s nullglob
  for f in "${PREVIOUS}/wp-"*.php "${PREVIOUS}/index.php" "${PREVIOUS}/xmlrpc.php"; do
    [[ "$(basename "$f")" == "wp-config.php" ]] && continue
    [[ -f "$f" ]] || continue
    cp -a "$f" "${LIVE}/"
  done
  shopt -u nullglob
}

run_command() {
  if ! is_wordpress_root "$LIVE"; then
    fail_run root "${LIVE} is not a WordPress root (need wp-config.php, wp-admin, wp-includes, wp-content)."
  fi
  if [[ -z "$HOME" || "$HOME" == "/" ]]; then
    die "HOME is unset or unsafe; refusing to continue."
  fi
  is_our_tmp_dir "$PREVIEW" "$PREVIEW_NAME" || die "Internal path mismatch for PREVIEW."
  is_our_tmp_dir "$PREVIOUS" "captaincore-core-previous" || die "Internal path mismatch for PREVIOUS."

  SITE_HOME="$(wp_stdout option get home)"
  SITE_HOST="${SITE_HOME#http://}"
  SITE_HOST="${SITE_HOST#https://}"
  SITE_HOST="${SITE_HOST%%/*}"
  CURRENT="$(wp_stdout core version)"
  DB_BEFORE="$(wp_stdout option get db_version)"
  RESULT_URL="$SITE_HOME"
  RESULT_FROM="$CURRENT"
  LIVE_CONTENT_DIR="$(wp_stdout eval 'echo defined("WP_CONTENT_DIR") ? WP_CONTENT_DIR : ABSPATH . "wp-content";')"
  LIVE_CONTENT_URL="$(wp_stdout eval 'echo defined("WP_CONTENT_URL") ? WP_CONTENT_URL : ( rtrim( home_url(), "/" ) . "/wp-content" );')"
  LIVE_PREFIX="$(wp_stdout eval 'global $wpdb; echo $wpdb->prefix;')"
  if [[ ! "$LIVE_PREFIX" =~ ^[A-Za-z0-9_]+$ ]]; then
    LIVE_PREFIX=""
  fi

  echo "site=${SITE_HOME}"
  echo "live_version=${CURRENT}"
  echo "db_version=${DB_BEFORE}"
  echo "content_dir=${LIVE_CONTENT_DIR}"
  echo "table_prefix=${LIVE_PREFIX}"

  mkdir -p "$(dirname "$PREVIEW")" "${HOME}/tmp"
  if [[ "$version" == "next" ]]; then
    resolve_next_core_version
  fi
  echo "target=${version}"
  safe_rm_tree "$PREVIEW" "$PREVIEW_NAME"
  echo "Downloading WordPress ${version} into preview..."
  if ! wp core download --path="$PREVIEW" --version="$version" --skip-content --force; then
    fail_run download "Failed to download WordPress ${version}"
  fi

  TARGET_VER="$(php -r "include '${PREVIEW}/wp-includes/version.php'; echo \$wp_version;")"
  TARGET_DB="$(php -r "include '${PREVIEW}/wp-includes/version.php'; echo \$wp_db_version;")"
  RESULT_TO="$TARGET_VER"
  echo "preview_version=${TARGET_VER}"
  echo "preview_db_version=${TARGET_DB}"

  if [[ "$CURRENT" == "$TARGET_VER" && "$probe_only" != "true" ]]; then
    RESULT_STATUS="ok"
    RESULT_ACTION="skip"
    RESULT_REASON="already-current"
    echo "Already on ${TARGET_VER}, nothing to update."
    return 0
  fi

  write_preview_config
  write_probe_php

  echo "CLI boot (plugins + themes)..."
  if ! wp --path="$PREVIEW" eval 'echo "booted=" . $GLOBALS["wp_version"] . " theme=" . get_template() . " plugins=" . count((array) get_option("active_plugins")) . "\n";'; then
    fail_run boot "Preview core failed to boot with live plugins/themes."
  fi

  echo "CLI render / ..."
  if ! wp --path="$PREVIEW" eval-file "${PREVIEW}/probe-render.php" /; then
    fail_run render "Preview core fatals rendering /"
  fi

  ABOUT_PATH="$(wp_stdout post list --post_type=page --post_status=publish --field=url --posts_per_page=1)"
  if [[ -n "$ABOUT_PATH" ]]; then
    ABOUT_PATH="${ABOUT_PATH#http://}"
    ABOUT_PATH="${ABOUT_PATH#https://}"
    ABOUT_PATH="/${ABOUT_PATH#*/}"
    [[ "$ABOUT_PATH" == "//"* ]] && ABOUT_PATH="/"
    echo "CLI render ${ABOUT_PATH} ..."
    if ! wp --path="$PREVIEW" eval-file "${PREVIEW}/probe-render.php" "$ABOUT_PATH"; then
      fail_run render "Preview core fatals rendering ${ABOUT_PATH}"
    fi
  fi

  echo "HTTP loopback live / ..."
  LIVE_HTTP="$(http_loopback /)"
  echo "live_http=${LIVE_HTTP}"

  write_http_bootstrap
  echo "HTTP loopback preview / ..."
  PREVIEW_HTTP="$(http_loopback "/${BOOT_FILE}?path=/" -H "X-Core-Preview: ${BOOT_TOKEN}")"
  PREVIEW_HDR="$(curl -ksS --max-time 30 -D - -o /dev/null -H "Host: ${SITE_HOST}" -H "X-Core-Preview: ${BOOT_TOKEN}" "https://localhost/${BOOT_FILE}?path=/")"
  PREVIEW_BOOT_VER="$(echo "$PREVIEW_HDR" | awk -F': ' 'tolower($1)=="x-core-preview-version" {gsub("\r","",$2); print $2}')"
  echo "preview_http=${PREVIEW_HTTP}"
  echo "preview_http_version=${PREVIEW_BOOT_VER}"
  if grep -qiE 'Fatal error|Parse error|Uncaught ' "$BODY_FILE"; then
    fail_run http "Preview HTTP response contains a PHP fatal."
  fi
  if http_ok "$PREVIEW_HTTP"; then
    :
  elif [[ -n "$PREVIEW_BOOT_VER" && "$PREVIEW_BOOT_VER" == "$TARGET_VER" && "$PREVIEW_HTTP" == "$LIVE_HTTP" ]]; then
    echo "preview_http_matches_live=${LIVE_HTTP}"
  else
    fail_run http "Preview HTTP ${PREVIEW_HTTP} (expected 200)."
  fi
  if [[ -n "$PREVIEW_BOOT_VER" && "$PREVIEW_BOOT_VER" != "$TARGET_VER" ]]; then
    fail_run http "HTTP booted ${PREVIEW_BOOT_VER}, expected ${TARGET_VER}."
  fi

  DB_AFTER="$(wp_stdout option get db_version)"
  if [[ "$DB_AFTER" != "$DB_BEFORE" ]]; then
    fail_run db "Probe mutated db_version (${DB_BEFORE} -> ${DB_AFTER})."
  fi
  echo "probe=ok"

  SHOULD_APPLY="false"
  if [[ "$probe_only" == "true" ]]; then
    SHOULD_APPLY="false"
  elif [[ "$apply" == "true" ]]; then
    SHOULD_APPLY="true"
  elif ! is_prerelease "$version" && ! is_prerelease "$TARGET_VER"; then
    SHOULD_APPLY="true"
  fi

  if [[ "$SHOULD_APPLY" != "true" ]]; then
    RESULT_STATUS="ok"
    RESULT_ACTION="skip"
    if [[ "$probe_only" == "true" ]]; then
      RESULT_REASON="probe-only"
    else
      RESULT_REASON="prerelease"
    fi
    echo "apply=skipped (pass --apply to update live core to ${TARGET_VER})"
    return 0
  fi

  echo "Backing up live core ${CURRENT}..."
  backup_live_core

  echo "Updating live core to ${TARGET_VER}..."
  if ! wp core update --skip-plugins --skip-themes --force --version="$version"; then
    restore_live_core
    fail_run apply "wp core update failed; restoring previous core."
  fi

  wp core update-db --skip-plugins --skip-themes
  if wp core is-installed --network --skip-plugins --skip-themes >/dev/null 2>&1; then
    wp core update-db --network --skip-plugins --skip-themes
  fi
  wp cache flush --skip-themes >/dev/null 2>&1 || true
  wp kinsta cache purge --skip-plugins --skip-themes --all >/dev/null 2>&1 || true
  wp cdn purge >/dev/null 2>&1 || true
  wp eval 'if ( function_exists( "rocket_clean_domain" ) ) { rocket_clean_domain(); echo "wp-rocket-purged\n"; }' >/dev/null 2>&1 || true

  echo "HTTP loopback after update..."
  POST_HTTP="$(http_loopback /)"
  POST_VER="$(wp_stdout core version)"
  echo "post_http=${POST_HTTP}"
  echo "post_version=${POST_VER}"
  if [[ "$POST_HTTP" != "200" && "$POST_HTTP" != "301" && "$POST_HTTP" != "302" ]]; then
    restore_live_core
    wp cache flush --skip-themes >/dev/null 2>&1 || true
    wp cdn purge >/dev/null 2>&1 || true
    RESTORED_HTTP="$(http_loopback /)"
    echo "restored_http=${RESTORED_HTTP}"
    fail_run apply "Live site HTTP ${POST_HTTP} after update; previous core restored."
  fi
  RESULT_STATUS="ok"
  RESULT_ACTION="apply"
  RESULT_TO="$POST_VER"
  echo "apply=ok"
}

run_command
